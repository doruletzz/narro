# ──────────────────────────────────────────────────────────────────────────
# Narro CMS — environment variables
#
# These are set in the NETLIFY dashboard (Site settings → Environment
# variables) for the keystatic.narro.co site. They are NOT committed.
# For local dev of the admin, copy the values into cms/.env (gitignored).
# ──────────────────────────────────────────────────────────────────────────

# ── Netlify (keystatic.narro.co — the Keystatic admin) ────────────────────

# GitHub OAuth App — create at:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Application name: Narro CMS
#   Homepage URL:  https://keystatic.narro.co
#   Authorization callback URL:
#     https://keystatic.narro.co/api/keystatic/github/oauth/callback
#   (also add for local dev:
#     http://127.0.0.1:4321/api/keystatic/github/oauth/callback)
# NOTE: Keystatic 0.6.x uses a GitHub OAuth App, not a fine-grained PAT —
# the admin signs in with GitHub in the browser (see CMS-SETUP.md).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random 32+ char string, e.g. `openssl rand -hex 32`.
# Used to encrypt the GitHub refresh-token cookie.
KEYSTATIC_SECRET=

# The secret you share with your client.
# Admin URL:  https://keystatic.narro.co/keystatic?token=<CMS_AUTH_TOKEN>
# Generate:   `openssl rand -hex 24`
CMS_AUTH_TOKEN=TOKEN123

# ── Local dev (optional) ──────────────────────────────────────────────────
# Run the admin locally:  pnpm --dir cms dev  →  http://127.0.0.1:4321/keystatic
# - Leave CMS_AUTH_TOKEN unset locally for open access (guard disabled).
# - KEYSTATIC_* values let you sign in with GitHub and edit the real repo
#   from local dev, exactly like production.

# ──────────────────────────────────────────────────────────────────────────
# Narro CMS (cms/) — environment variables for Netlify
#
# Deployed to: https://keystatic.narro.co
# Uses Keystatic Cloud — no GitHub OAuth or secrets needed.
# For local dev of the admin, copy the value into cms/.env (gitignored).
# ──────────────────────────────────────────────────────────────────────────

# The secret you share with your client.
# Admin URL:  https://keystatic.narro.co/keystatic?token=<CMS_AUTH_TOKEN>
# Generate:   `openssl rand -hex 24`
CMS_AUTH_TOKEN=TOKEN123

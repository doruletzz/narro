# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
GTM_ID=GTM-XXXXXXX

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
GA_ID=G-XXXXXXX

# Access token for the CMS admin (used by src/middleware.ts)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Your client accesses: https://www.narro.co/keystatic?token=<YOUR_TOKEN>
CMS_AUTH_TOKEN=your-access-token-here

# Keystatic — used for the admin session cookie (any random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=your-secret-here

# NOTE: The frontend reads content at build time from `src/content/`.
# The CMS (cms/) writes content there. No GitHub OAuth needed here.

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
GTM_ID=GTM-XXXXXXX

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
GA_ID=G-XXXXXXX

# Access token for the CMS admin (used by src/middleware.ts)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Your client accesses: https://www.narro.co/keystatic?token=<YOUR_TOKEN>
CMS_AUTH_TOKEN=your-access-token-here

# Keystatic — used for the admin session cookie (any random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=your-secret-here

# Keystatic GitHub storage — these are ONLY used in production.
# Create a GitHub OAuth App:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Callback URL: https://your-domain.com/api/keystatic/github/authenticate
#   Authorization callback URL: https://your-domain.com/api/keystatic/github/authenticate
#   Application website: https://your-domain.com
#   Authorization request URL: https://your-domain.com/api/keystatic/github/authorize
#   Redirect URL: https://your-domain.com/api/keystatic/github/callback
KEYSTATIC_GITHUB_CLIENT_ID=your-github-client-id
KEYSTATIC_GITHUB_CLIENT_SECRET=your-github-client-secret

---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layouts/Header.astro';
import Footer from '../components/layouts/Footer.astro';
import CookieConsent from '../components/layouts/CookieConsent.astro';
import Gtm from '../components/analytics/Gtm.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  twitterImage?: string;
}

const {
  title,
  description,
  ogImage,
  ogTitle,
  ogDescription,
  ogUrl,
  twitterImage,
} = Astro.props;

// Build-time environment variables (set via .env file or CI/CD)
const GTM_ID = import.meta.env.GTM_ID;
const GA_ID  = import.meta.env.GA_ID;
// Skip the snippet entirely when no real container ID is configured (dev).
const HAS_GTM = Boolean(GTM_ID && !GTM_ID.includes('XXXX'));
---

<BaseLayout>
  <Fragment slot="head">
    {HAS_GTM && <Gtm gtmId={GTM_ID} gaId={GA_ID} />}
    <slot name="head">
      {title && <title>{title}</title>}
      {description && <meta name="description" content={description} />}
      {ogImage && <meta property="og:image" content={ogImage} />}
      {ogTitle && <meta property="og:title" content={ogTitle} />}
      {ogDescription && <meta property="og:description" content={ogDescription} />}
      {ogUrl && <meta property="og:url" content={ogUrl} />}
      {twitterImage && <meta name="twitter:image" content={twitterImage} />}
    </slot>
  </Fragment>

  <style is:global>
    /* ===== Scroll-to-top button ===== */
    .scroll-top-btn {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 100;
      width: 3rem;
      height: 3rem;
      border-radius: 9999px;
      border: none;
      background: #2200d8;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: opacity 400ms, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .scroll-top-btn.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .scroll-top-btn:hover {
      background: #4f2eff;
    }
    .scroll-top-btn:focus {
      outline: 2px solid #FF66C4;
      outline-offset: 2px;
    }
    .doodle-scribble {
      opacity: 0.7;
    }
    .doodle-scribble path,
    .doodle-scribble ellipse,
    .doodle-scribble circle {
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ===== Smooth Fade-In Animation System ===== */
    @keyframes fadeInUp {
      0% {
        opacity: 0;
        transform: translateY(24px);
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0px);
      }
    }

    /* Base hidden state */
    .fade-in {
      opacity: 0;
      will-change: opacity, transform, filter;
    }

    /* Doodles start at a hair of opacity (0.0001) instead of fully invisible.
       Visually identical to fading from 0, but the browser paints them from
       the first frame, so the hero doodle (the LCP element) registers as
       painted as soon as its SVG loads instead of waiting for JS. */
    .doodle-scribble.fade-in {
      opacity: 0.0001;
    }

    /* Triggered state */
    .fade-in.active {
      animation: fadeInUp 1.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Stagger Delays */
    .fade-delay-1 { animation-delay: 0ms !important; }
    .fade-delay-2 { animation-delay: 150ms !important; }
    .fade-delay-3 { animation-delay: 300ms !important; }
    .fade-delay-4 { animation-delay: 450ms !important; }
    .fade-delay-5 { animation-delay: 600ms !important; }
    .fade-delay-6 { animation-delay: 750ms !important; }
    .fade-delay-7 { animation-delay: 900ms !important; }

    /* Internal navigation (same tab/session): the header shows instantly,
       without the fade-in. Set on <html> by the script below. */
    .internal-nav #site-header .fade-in {
      opacity: 1;
      animation: none !important;
    }
  </style>
  
  <!-- Skip to content link for accessibility -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-[#2200d8] focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
  >
    Săriți peste conținut
  </a>
  
  <Header />

  <main id="main-content" class="min-h-screen  max-w-[100vw] overflow-hidden">
    <slot />
  </main>
  <Footer />
  <CookieConsent />

  <!-- Scroll-to-top button -->
  <button
    class="scroll-top-btn z-50"
    id="scroll-top-btn"
    aria-label="Înapoi sus"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <script is:inline>
    /* ===== Smooth Fade-In Scroll Observer ===== */
    document.addEventListener('DOMContentLoaded', () => {
      /* Header fade-in only on the first visit of a tab session (new tab or
         arrival from outside). On internal navigation the header shows
         instantly. We use a sessionStorage flag instead of document.referrer,
         which is unreliable (stripped by privacy settings / referrer policies
         and never changes on client-side navigation). */
      let isInternalNav = false;
      try {
        isInternalNav = sessionStorage.getItem('narro:internal-nav') === '1';
        if (!isInternalNav) sessionStorage.setItem('narro:internal-nav', '1');
      } catch (e) {
        isInternalNav = false; // sessionStorage unavailable (e.g. blocked storage)
      }
      if (isInternalNav) {
        document.documentElement.classList.add('internal-nav');
      }

      const isMobile = window.innerWidth < 768;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { 
        threshold: isMobile ? 0.03 : 0.1,
        rootMargin: '0px 0px -40px 0px'
      });

      document.querySelectorAll('.fade-in').forEach(el => {
        observer.observe(el);
      });
    });
  </script>
  <script is:inline>
  (function () {
    var btn = document.getElementById('scroll-top-btn');
    if (!btn) return;

    function update() {
      btn.classList.toggle('visible', window.scrollY > window.innerHeight * 1.3);
    }

    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
</BaseLayout>

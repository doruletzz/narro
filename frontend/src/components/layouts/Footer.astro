---
// Footer component with contact info, links, and copyright

const phone = '+40 729 729 695';
const email = 'contact@narro.co';
const logoText = 'NARRO';

const footerLinks = [
  { label: 'Politica Cookies', href: '/politica-cookies' },
  { label: 'Confidentialitate', href: '/confidentialitate' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand column -->
      <div class="space-y-4">
        <a href="/" class="font-heading font-bold text-2xl tracking-wider hover:text-accent transition-colors">
          {logoText}
        </a>
        <p class="text-sm text-white/60">
          Branding și comunicare vizuală.
        </p>
      </div>

      <!-- Contact column -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/80">Contact</h3>
        <div class="space-y-2 text-sm text-white/60">
          <a href={`tel:${phone}`} class="block hover:text-white transition-colors">{phone}</a>
          <a href={`mailto:${email}`} class="block hover:text-white transition-colors">{email}</a>
        </div>
      </div>

      <!-- Quick links column -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/80">Link-uri rapide</h3>
        <div class="space-y-2 text-sm text-white/60">
          {footerLinks.map((link) => (
            <a href={link.href} class="block hover:text-white transition-colors">{link.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="py-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/40">
      <p>{currentYear}© NARRO BRANDING SRL</p>
      <div class="flex items-center gap-4">
        {footerLinks.map((link) => (
          <a href={link.href} class="hover:text-white/60 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>

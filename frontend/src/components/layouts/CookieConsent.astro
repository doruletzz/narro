---
// Cookie Consent Banner Component
// Implements localStorage-based consent tracking with smooth animation

interface Props {
  acceptText?: string;
  declineText?: string;
  message?: string;
  policyLink?: string;
}

const {
  acceptText = 'Accept',
  declineText = 'Decline',
  message = 'We use cookies to improve your experience. By continuing, you agree to our cookie policy.',
  policyLink = '/politica-cookies',
} = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 mb-4">
    <div class="bg-neutral-900 text-white rounded-lg shadow-lg p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <p class="flex-1 text-sm text-white/80">
        {message}
        <a href={policyLink} class="text-accent hover:text-accent-dark underline transition-colors ml-1">
          Cookie Policy
        </a>
      </p>
      <div class="flex items-center gap-3 flex-shrink-0">
        <button
          type="button"
          id="cookie-decline"
          class="px-4 py-2 text-sm font-medium text-white bg-transparent border border-white/30 rounded-md hover:bg-white/10 hover:border-white/50 transition-colors focus:outline-none focus:ring-2 focus:ring-white/30 focus:ring-offset-2 focus:ring-offset-neutral-900"
        >
          {declineText}
        </button>
        <button
          type="button"
          id="cookie-accept"
          class="px-4 py-2 text-sm font-medium text-neutral-900 bg-accent rounded-md hover:bg-accent-dark transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-neutral-900"
        >
          {acceptText}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const COOKIE_CONSENT_KEY = 'narro_cookie_consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  function setConsent(accepted: boolean) {
    localStorage.setItem(COOKIE_CONSENT_KEY, String(accepted));
    banner?.classList.add('translate-y-full');
  }

  function showBanner() {
    setTimeout(() => {
      banner?.classList.remove('translate-y-full');
    }, 500);
  }

  // Check if consent was already given
  const existingConsent = localStorage.getItem(COOKIE_CONSENT_KEY);
  if (!existingConsent) {
    showBanner();
  }

  acceptBtn?.addEventListener('click', () => setConsent(true));
  declineBtn?.addEventListener('click', () => setConsent(false));

  // Keyboard support: Enter/Space on buttons
  [acceptBtn, declineBtn].forEach((btn) => {
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        btn.click();
      }
    });
  });
</script>

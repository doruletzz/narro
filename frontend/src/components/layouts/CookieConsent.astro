---
// Cookie Consent Banner Component
// Implements localStorage-based consent tracking with smooth animation
// Matches Figma design tokens (cream, primary, accent)

interface Props {
  acceptText?: string;
  declineText?: string;
  message?: string;
  policyLink?: string;
}

const {
  acceptText = 'Accept',
  declineText = 'Refuz',
  message = 'Folosim cookie-uri pentru a îmbunătăți experiența ta. Continui, și de acord cu politica noastră de cookie-uri.',
  policyLink = '/politica-cookies',
} = Astro.props;
---

<div
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 mb-8">
    <div class="bg-[#2200d8] text-white rounded-2xl shadow-lg p-4 sm:p-3 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <p class="flex-1 text-lg text-white/80 lg:ml-4">
        {message}
        <a href={policyLink} class="text-[#ff99d8] hover:text-white underline transition-colors ml-1">
          Cookie Policy
        </a>
      </p>
      <div class="flex items-center gap-3 flex-shrink-0 mr-1">
        <button
          type="button"
          id="cookie-decline"
          class="px-4 py-2 text-lg w-24 font-medium text-white bg-transparent border border-white/30 rounded-xl hover:bg-white/10 hover:border-white/50 transition-colors focus:outline-none focus:ring-2 focus:ring-[#ff99d8] focus:ring-offset-2 focus:ring-offset-[#2200d8]"
        >
          {declineText}
        </button>
        <button
          type="button"
          id="cookie-accept"
          class="px-4 py-2 text-lg w-24 font-medium text-primary bg-[#ff99d8] rounded-lg hover:bg-[#ff88c8] transition-colors focus:outline-none focus:ring-2 focus:ring-[#ff99d8] focus:ring-offset-2 focus:ring-offset-[#2200d8]"
        >
          {acceptText}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const COOKIE_CONSENT_KEY = 'narro_cookie_consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');

  function setConsent(accepted: boolean) {
    localStorage.setItem(COOKIE_CONSENT_KEY, String(accepted));
    banner?.classList.add('translate-y-full');
    updateConsentMode(accepted);
  }

  // Google Consent Mode v2 — release (or keep) the GA4 tag that GTM holds.
  // On accept, the GA4 tag fires retroactively and records the current
  // pageview immediately, without waiting for the next page load.
  // No-op if GTM is not loaded (e.g. no container configured).
  function updateConsentMode(accepted: boolean) {
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('consent', 'update', {
      ad_storage: accepted ? 'granted' : 'denied',
      ad_user_data: accepted ? 'granted' : 'denied',
      ad_personalization: accepted ? 'granted' : 'denied',
      analytics_storage: accepted ? 'granted' : 'denied',
    });
  }

  function showBanner() {
    setTimeout(() => {
      banner?.classList.remove('translate-y-full');
    }, 500);
  }

  // Check if consent was already given
  const existingConsent = localStorage.getItem(COOKIE_CONSENT_KEY);
  if (!existingConsent) {
    showBanner();
  }

  acceptBtn?.addEventListener('click', () => setConsent(true));
  declineBtn?.addEventListener('click', () => setConsent(false));

  // Keyboard support: Enter/Space on buttons
  [acceptBtn, declineBtn].forEach((btn) => {
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        btn.click();
      }
    });
  });
</script>

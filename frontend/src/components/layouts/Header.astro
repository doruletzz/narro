---
import { Image } from "astro:assets";

// Header component — matches Figma: white bg, purple text, narro logo, contact pill button
---

<header class="bg-[#f5f0eb] sticky top-0 z-50 transition-[shadow,transform] duration-[700ms] ease-in-out" id="site-header">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 fade-in">
        <Image src="/logo.svg" width="64" height="32" alt="Narro" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-6" aria-label="Main navigation">
        <a href="/servicii" class="text-sm fade-in fade-delay-1 font-medium uppercase text-primary hover:text-accent transition-colors tracking-wide">Servicii</a>
        <a href="/studii-de-caz" class="text-sm  fade-in fade-delay-2 font-medium uppercase text-primary hover:text-accent transition-colors tracking-wide">Portofoliu</a>
        <a href="/program-social" class="text-sm  fade-in fade-delay-3 font-medium uppercase text-primary hover:text-accent transition-colors tracking-wide">Program Social</a>
        <a href="/story-time" class="text-sm  fade-in fade-delay-4 font-medium uppercase text-primary hover:text-accent transition-colors tracking-wide">Story Time</a>
      </nav>

      <!-- Contact Button (desktop) -->
      <div class=" lg:ml-0 ml-auto mx-2">
        <a
          href="/contact"
          class="inline-flex items-center fade-in fade-delay-1 gap-2 px-5 py-2 pt-2.5 text-sm font-medium text-neutral-900 border border-[#FF66C4] rounded-full hover:border-[#2200d8] hover:bg-[#2200d8] hover:text-white transition-colors tracking-wide group/cta"
        >
          CONTACT
          <svg class="w-4 h-4 mb-0.5 group-hover/cta:rotate-45 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-md text-primary hover:bg-primary/5 focus:outline-none"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="sr-only">Open main menu</span>
        <svg class="w-6 h-6 block" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

    <!-- Mobile menu backdrop -->
  <div
    class="lg:hidden fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
    id="mobile-menu-backdrop"
    aria-hidden="true"
  ></div>

  <!-- Mobile menu panel (slides in from right) -->
  <div
    class="lg:hidden fixed inset-y-0 right-0 z-50 w-[80vw] max-w-sm bg-[#f5f0eb] shadow-2xl translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
    id="mobile-menu"
    aria-hidden="true"
    inert
  >
    <nav class="flex flex-col h-full px-6 py-8 space-y-3" aria-label="Mobile navigation">
      <a href="/servicii" class="block text-base font-medium uppercase text-primary hover:text-accent transition-colors py-2">Servicii</a>
      <a href="/studii-de-caz" class="block text-base font-medium uppercase text-primary hover:text-accent transition-colors py-2">Portofoliu</a>
      <a href="/program-social" class="block text-base font-medium uppercase text-primary hover:text-accent transition-colors py-2">Program Social</a>
      <a href="/story-time" class="block text-base font-medium uppercase text-primary hover:text-accent transition-colors py-2">Story Time</a>

      <div class="">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-neutral-900 border border-[#FF66C4] rounded-full hover:border-[#2200d8] hover:bg-[#2200d8] hover:text-white transition-colors"
        >
          CONTACT
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>

      <!-- Explicit close button, pinned to bottom of panel -->
      <button
        type="button"
        id="mobile-menu-close"
        class="absolute right-4 top-2"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

    <script>
    const header = document.getElementById('site-header');
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const closeButton = document.getElementById('mobile-menu-close');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    function openMenu() {
      button?.setAttribute('aria-expanded', 'true');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.removeAttribute('inert');
      menu?.classList.remove('translate-x-full');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      button?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.setAttribute('inert', '');
      menu?.classList.add('translate-x-full');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    button?.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      isExpanded ? closeMenu() : openMenu();
    });

    closeButton?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      const isOpen = button?.getAttribute('aria-expanded') === 'true';
      if (isOpen && !menu?.contains(target) && !button?.contains(target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        button?.focus();
      }
    });

    let lastScrollY = window.scrollY;

    const updateHeader = () => {
      const scrollY = window.scrollY;
      const pastThreshold = scrollY > (1.3 * window.innerHeight);

      if (!pastThreshold) {
        header?.classList.remove('-translate-y-full');
      } else if (scrollY > lastScrollY) {
        header?.classList.add('-translate-y-full');
      } else {
        header?.classList.remove('-translate-y-full');
      }

      if (header?.classList.contains('-translate-y-full') && button?.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }

      lastScrollY = scrollY;
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  </script>
</header>
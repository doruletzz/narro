---
// CTA section — wrapper for the pink pill CtaBlock
// Matches Figma's consistent "ZI-NE CARE-I TREABA?" CTA pattern

import CtaBlock from '../ui/CtaBlock.astro';

interface Props {
  imageUrl?: string;
  buttonText?: string;
  link?: string;
}

const {
  imageUrl,
  buttonText = 'ZI-NE CARE-I TREABA?',
  link = '/contact',
} = Astro.props;
---

<CtaBlock
  imageUrl={imageUrl}
  buttonText={buttonText}
  link={link}
>
  <slot />
</CtaBlock>

---
import { parseMarkdown } from '@/lib/markdown-utils';

interface CtaBannerData {
  image: string;
  imageAlt: string;
  text: string;
  href: string;
  description?: string;
}

interface Props {
  ctaBanner: CtaBannerData;
}

const { ctaBanner }: Props = Astro.props;
const { description } = ctaBanner;
---

<section class="relative flex flex-col items-center justify-center gap-8 sm:gap-12 overflow-hidden py-16 sm:py-24 min-h-[80vh] fade-in fade-delay-1" style="background-color: #f5f0eb;">
  {description && (
    <p class="relative z-10 w-full max-w-3xl px-4 text-center text-lg md:text-2xl text-neutral-800 leading-relaxed fade-in fade-delay-1">
      {description}
    </p>
  )}
  {ctaBanner.image && (
    <img
      src={ctaBanner.image}
      alt={ctaBanner.imageAlt}
      class="relative z-0 w-full max-w-4xl mx-auto transition-transform duration-500 ease-out peer-hover/cta:!scale-[98%] fade-in fade-delay-2"
    />
  )}
  <div class="peer/cta relative z-10 w-full px-4 md:max-w-5xl group/cta hover:scale-[102%] transition-transform duration-150 fade-in fade-delay-3">
    <a href={ctaBanner.href} class="inline-flex w-full justify-between gap-0 sm:gap-3 transition-colors duration-300 bg-[#ff99d8] group-hover/cta:bg-[#2200d8] rounded-full pl-10 md:pl-14 pr-4 py-3 sm:py-4">
      <span class="md:text-7xl text-4xl font-heading font-bold uppercase tracking-wider transition-colors duration-300 group-hover/cta:text-white text-[#2200d8]" set:html={parseMarkdown(ctaBanner.text.replace('\n', '<br/>'))} />
      <div class="h-full aspect-square rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #2200d8;">
        <svg class="group-hover/cta:rotate-45 transition-transform duration-150 size-20 md:size-36 fill-white text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </div>
    </a>
  </div>
</section>

---
import { parseMarkdown } from '@/lib/markdown-utils';

interface CtaBannerData {
  image: string;
  imageAlt: string;
  text: string;
  href: string;
}

interface Props {
  ctaBanner: CtaBannerData;
}

const { ctaBanner }: Props = Astro.props;
---

<section class="relative flex fade-in fade-delay-1 relative min-h-[90vh] overflow-hidden py-8 sm:py-48" style="background-color: #f5f0eb;">
  <div class="peer/cta absolute z-10 bottom-1/3 left-1/2 -translate-x-1/2 right-0 active w-full px-4 md:max-w-5xl group/cta hover:scale-[102%] transition-transform duration-150">
    <a href={ctaBanner.href} class="inline-flex w-full fade-in fade-delay-3 justify-between gap-2 sm:gap-3 transition-colors duration-300 bg-[#ff99d8] group-hover/cta:bg-[#2200d8] rounded-full pl-14 pr-4 py-3 sm:py-4">
      <span class="md:text-7xl text-4xl font-heading font-bold uppercase tracking-wider transition-colors duration-300 group-hover/cta:text-white text-[#2200d8]" set:html={parseMarkdown(ctaBanner.text.replace('\n', '<br/>'))} />
      <div class="h-full aspect-square rounded-full flex items-center justify-center flex-shrink-0" style="background-color: #2200d8;">
        <svg class="group-hover/cta:rotate-45 transition-transform duration-150 size-20 md:size-36 fill-white text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </div>
    </a>
  </div>
  {ctaBanner.image && (
    <img
      src={ctaBanner.image}
      alt={ctaBanner.imageAlt}
      class="w-[112rem] object-cover overflow-hidden mx-auto transition-transform duration-500 ease-out peer-hover/cta:!scale-[98%]"
    />
  )}
</section>
---
// Testimonials section

interface Props {
  title?: string;
  testimonials?: Array<{
    quote: string;
    author: string;
    role?: string;
    avatar?: string;
  }>;
}

const { title, testimonials = [] } = Astro.props;

import Heading from '../ui/Heading.astro';
---

<section class="py-16 md:py-24 bg-neutral-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {title && (
      <div class="text-center mb-12">
        <Heading level={2}>{title}</Heading>
      </div>
    )}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <blockquote class="bg-white rounded-lg shadow-md p-6 space-y-4">
          <p class="text-neutral-700 italic leading-relaxed">&ldquo;{t.quote}&rdquo;</p>
          <footer class="flex items-center gap-3">
            {t.avatar && (
              <img
                src={t.avatar}
                alt={t.author}
                class="w-10 h-10 rounded-full object-cover"
              />
            )}
            <div>
              <cite class="not-italic font-semibold text-neutral-900">{t.author}</cite>
              {t.role && <p class="text-sm text-neutral-500">{t.role}</p>}
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
    <slot />
  </div>
</section>

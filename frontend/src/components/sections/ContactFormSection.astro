---
// Contact form section

interface Props {
  title?: string;
  subtitle?: string;
  submitText?: string;
  action?: string;
}

const {
  title = 'Contact Us',
  subtitle = 'Fill out the form below and we\'ll get back to you soon.',
  submitText = 'Send Message',
  action = '/api/contact',
} = Astro.props;

import Heading from '../ui/Heading.astro';
import TextBlock from '../ui/TextBlock.astro';
import Button from '../ui/Button.astro';
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      {title && <Heading level={2}>{title}</Heading>}
      {subtitle && (
        <TextBlock class="mt-4 text-neutral-600">{subtitle}</TextBlock>
      )}
    </div>
    <form action={action} method="POST" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-neutral-700 mb-1">
            Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2.5 border border-neutral-300 rounded-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-neutral-900 bg-white"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2.5 border border-neutral-300 rounded-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-neutral-900 bg-white"
            placeholder="your@email.com"
          />
        </div>
      </div>
      <div>
        <label for="subject" class="block text-sm font-medium text-neutral-700 mb-1">
          Subject
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          class="w-full px-4 py-2.5 border border-neutral-300 rounded-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-neutral-900 bg-white"
          placeholder="What is this about?"
        />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-neutral-700 mb-1">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows={5}
          required
          class="w-full px-4 py-2.5 border border-neutral-300 rounded-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all text-neutral-900 bg-white resize-vertical"
          placeholder="Your message..."
        />
      </div>
      <div class="text-center">
        <Button type="submit" variant="primary" size="lg">
          {submitText}
        </Button>
      </div>
      <slot />
    </form>
  </div>
</section>

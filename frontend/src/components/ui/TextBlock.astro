---
// TextBlock component — matches Figma:
// - Leading-relaxed text
// - neutral-700 color for body text
// - neutral-600 for secondary text

interface Props {
  variant?: 'body' | 'secondary' | 'caption';
  className?: string;
}

const {
  variant = 'body',
  className = '',
} = Astro.props;

const variantClasses: Record<string, string> = {
  'body': 'text-neutral-700 leading-relaxed',
  'secondary': 'text-neutral-600 leading-relaxed',
  'caption': 'text-xs text-neutral-500',
};

const classes = `${variantClasses[variant]} ${className}`;
---

<p class={classes}>
  <slot />
</p>

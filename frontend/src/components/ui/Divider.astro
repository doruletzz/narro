---
// Section divider — matches Figma: subtle primary/10 border-top style
// Also supports solid color dividers for section separation

interface Props {
  class?: string;
  color?: string;
  thickness?: 'thin' | 'medium' | 'thick';
}

const {
  class: customClass = '',
  color = 'border-primary/10',
  thickness = 'thin',
} = Astro.props;

const thicknessClasses = {
  thin: 'h-px',
  medium: 'h-0.5',
  thick: 'h-1',
};
---

<div class={`${color} ${thicknessClasses[thickness]} ${customClass}`} role="separator" />

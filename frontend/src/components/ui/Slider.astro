---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /**
   * Keep the mobile edge-to-edge layout at all breakpoints.
   * When false, the track becomes contained from md upwards.
   */
  bleed?: boolean;

  /**
   * Enable scroll snapping.
   * Defaults to true.
   */
  snap?: boolean;

  /**
   * Desktop overflow behaviour:
   * - scroll: horizontally scrollable track
   * - visible: wrapping flex layout with no scrolling
   */
  desktopOverflow?: 'scroll' | 'visible';
}

const {
  id,
  bleed = false,
  snap = true,
  desktopOverflow = 'scroll',
  class: className = '',
  ...rest
} = Astro.props;

const isVisibleDesktop = desktopOverflow === 'visible';
---

<div
  id={id}
  data-slider
  data-desktop-overflow={desktopOverflow}
  class:list={[
    'slider relative flex flex-nowrap gap-1 md:gap-2',
    'overflow-x-auto scroll-smooth no-scrollbar',
    'select-none pb-6 pt-2 -mx-4 px-4',
    !bleed && 'md:mx-0 md:px-0',
    snap && 'snap-x snap-mandatory snap-start',
    isVisibleDesktop && [
      'md:flex-wrap md:overflow-visible',
      'md:snap-none md:cursor-auto md:pb-0',
    ],
    className,
  ]}
  {...rest}
>
  <slot />

  {/* Arrow buttons — absolutely positioned inside track */}
  <button class="slider-arrow slider-arrow-prev" data-arrow="prev" type="button" aria-label="Previous card">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>
  <button class="slider-arrow slider-arrow-next" data-arrow="next" type="button" aria-label="Next card">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
    </svg>
  </button>
</div>

<style>
  .slider {
    touch-action: pan-x pan-y;
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .slider > :global(*) {
    scroll-snap-align: center;
  }

  .slider[data-draggable] {
    cursor: grab;
  }

  .slider[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .slider[data-dragging] :global(a),
  .slider[data-dragging] :global(button) {
    pointer-events: none;
  }

  /* ── Arrow buttons ────────────────────────────────── */
  .slider-arrow {
    --arrow-size: 40px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    width: var(--arrow-size);
    height: var(--arrow-size);
    border-radius: 50%;
    border: 2px solid #2200d8;
    background: #f5f0eb;
    color: #2200d8;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .slider-arrow:hover {
    background: #2200d8;
    color: #fff;
  }

  /* Position left arrow at the far-left edge of the visible track area */
  .slider-arrow-prev {
    left: 0;
  }

  /* Position right arrow at the far-right edge of the visible track area */
  .slider-arrow-next {
    right: 0;
  }

  /* Hide on mobile */
  @media (max-width: 767px) {
    .slider-arrow {
      display: none !important;
    }
  }
</style>

<script>
  const DRAG_THRESHOLD = 4;

  function initSlider(track: HTMLElement) {
    if (track.dataset.sliderInitialized !== undefined) return;
    track.dataset.sliderInitialized = '';

    let pointerId: number | null = null;
    let startX = 0;
    let startScrollLeft = 0;
    let didDrag = false;

    const isScrollable = () =>
      track.scrollWidth > track.clientWidth + 1;

    const updateDraggable = () => {
      track.toggleAttribute('data-draggable', isScrollable());
    };

    const endDrag = () => {
      if (pointerId === null) return;
      track.removeAttribute('data-dragging');
      if (track.hasPointerCapture(pointerId)) {
        track.releasePointerCapture(pointerId);
      }
      pointerId = null;
    };

    const handlePointerDown = (event: PointerEvent) => {
      if (event.pointerType === 'touch' || !isScrollable()) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startScrollLeft = track.scrollLeft;
      didDrag = false;
    };

    const handlePointerMove = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      const deltaX = event.clientX - startX;
      if (!didDrag && Math.abs(deltaX) > DRAG_THRESHOLD) {
        didDrag = true;
        track.setAttribute('data-dragging', '');
        track.setPointerCapture(pointerId);
      }
      if (didDrag) {
        track.scrollLeft = startScrollLeft - deltaX;
      }
    };

    const handlePointerEnd = () => endDrag();

    const handleClick = (event: MouseEvent) => {
      if (!didDrag) return;
      event.preventDefault();
      event.stopPropagation();
      didDrag = false;
    };

    track.addEventListener('pointerdown', handlePointerDown);
    track.addEventListener('pointermove', handlePointerMove);
    track.addEventListener('pointerup', handlePointerEnd);
    track.addEventListener('pointercancel', handlePointerEnd);
    track.addEventListener('click', handleClick, true);

    const resizeObserver = new ResizeObserver(updateDraggable);
    resizeObserver.observe(track);
    updateDraggable();

    /* ── Arrow buttons ────────────────────────────── */
    const prevBtn = track.querySelector('[data-arrow="prev"]') as HTMLButtonElement | null;
    const nextBtn = track.querySelector('[data-arrow="next"]') as HTMLButtonElement | null;

    const updateArrows = () => {
      if (!prevBtn || !nextBtn) return;
      if (!isScrollable()) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        return;
      }

      const maxScroll = track.scrollWidth - track.clientWidth;
      const atStart = track.scrollLeft <= 2;
      const atEnd   = track.scrollLeft >= maxScroll - 2;

      // Right arrow: visible when nothing is scrolled yet (at start)
      nextBtn.style.display = atStart ? 'flex' : 'none';
      // Left arrow: visible once we've scrolled past start, hidden when at end
      prevBtn.style.display = (atStart || atEnd) ? 'none' : 'flex';
    };

    const goPrev = () => {
      track.scrollBy({ left: -320, behavior: 'smooth' });
    };

    const goNext = () => {
      track.scrollBy({ left: 320, behavior: 'smooth' });
    };

    if (prevBtn) prevBtn.addEventListener('click', goPrev);
    if (nextBtn) nextBtn.addEventListener('click', goNext);
    track.addEventListener('scroll', updateArrows, { passive: true });

    // Run once after a short delay to let layout settle
    requestAnimationFrame(() => {
      requestAnimationFrame(updateArrows);
    });

    return () => {
      resizeObserver.disconnect();
      if (prevBtn) prevBtn.removeEventListener('click', goPrev);
      if (nextBtn) nextBtn.removeEventListener('click', goNext);
      track.removeEventListener('scroll', updateArrows);
      track.removeEventListener('pointerdown', handlePointerDown);
      track.removeEventListener('pointermove', handlePointerMove);
      track.removeEventListener('pointerup', handlePointerEnd);
      track.removeEventListener('pointercancel', handlePointerEnd);
      track.removeEventListener('click', handleClick, true);
    };
  }

  function initAllSliders() {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach(initSlider);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllSliders, { once: true });
  } else {
    initAllSliders();
  }
</script>

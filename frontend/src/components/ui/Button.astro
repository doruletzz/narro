---
// Button component — matches Figma:
// - Primary: solid bg, white text
// - Outline: solid border, text bg on hover
// - Pill: rounded-full variant

type Variant = 'primary' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  pill?: boolean;
  block?: boolean;
  arrow?: boolean;
  href?: string;
}

const {
  variant = 'primary',
  size = 'md',
  pill = false,
  block = false,
  arrow = false,
  href,
} = Astro.props;

const variantClasses: Record<Variant, string> = {
  primary: 'bg-[#2200d8] text-white hover:bg-[#110088]',
  outline: 'border border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white',
  ghost: 'text-primary hover:text-accent',
};

const sizeClasses: Record<Size, string> = {
  sm: 'text-xs px-3 py-1.5',
  md: 'text-sm px-5 py-2',
  lg: 'text-base px-6 py-3',
};

const classes = `${variantClasses[variant]} ${sizeClasses[size]} ${pill ? 'rounded-full' : 'rounded'} ${block ? 'w-full' : ''} inline-flex items-center justify-center font-medium transition-colors tracking-wide`;
---

{#if href}
  <a
    href={href}
    class={classes}
  >
    <slot />
    {#if arrow}
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
      </svg>
    {/if}
  </a>
{:else}
  <button
    class={classes}
  >
    <slot />
    {#if arrow}
      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
      </svg>
    {/if}
  </button>
{/if}

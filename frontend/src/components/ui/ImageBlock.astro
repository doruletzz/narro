---
// ImageBlock component — matches Figma:
// - Rounded corners (rounded-lg or rounded-2xl)
// - Object-cover images
// - Optional lazy loading

interface Props {
  src: string;
  alt: string;
  rounded?: 'lg' | '2xl';
  aspectRatio?: string;
  lazy?: boolean;
}

const {
  src,
  alt,
  rounded = 'lg',
  aspectRatio,
  lazy = true,
} = Astro.props;

const roundedClass = rounded === '2xl' ? 'rounded-2xl' : 'rounded-lg';
---

<div class={`${aspectRatio || ''} ${aspectRatio ? roundedClass : ''} bg-cream overflow-hidden`}>
  <img
    src={src}
    alt={alt}
    class={`w-full h-full object-cover ${!aspectRatio ? roundedClass : ''}`}
    loading={lazy ? 'lazy' : 'eager'}
  />
</div>

---
// Section component — matches Figma:
// - Max-width container
// - Consistent padding

interface Props {
  id?: string;
  className?: string;
}

const { id, className = '' } = Astro.props;
---

<section id={id} class={`px-4 sm:px-6 lg:px-8 ${className}`}>
  <div class="max-w-7xl mx-auto">
    <slot />
  </div>
</section>

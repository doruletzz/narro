---
// Heading component (H1-H6) with Figma typography styles

interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl';
  class?: string;
  color?: 'default' | 'white' | 'accent';
}

const {
  level = 1,
  size,
  class: customClass = '',
  color = 'default',
} = Astro.props;

const sizeMap: Record<number, string> = {
  1: 'text-4xl md:text-5xl lg:text-6xl',
  2: 'text-3xl md:text-4xl',
  3: 'text-2xl md:text-3xl',
  4: 'text-xl md:text-2xl',
  5: 'text-lg md:text-xl',
  6: 'text-base md:text-lg',
};

const colorClasses = {
  default: 'text-neutral-900',
  white: 'text-white',
  accent: 'text-accent',
};

const Tag = `h${level}` as const;
---

<Tag class={`font-heading font-bold leading-tight tracking-tight ${sizeMap[level]} ${colorClasses[color]} ${customClass}`}>
  <slot />
</Tag>

---
// Heading component — matches Figma:
// - Section label (uppercase, pink, wide tracking)
// - Page heading (Bristol, large, pink)
// - Body heading (Bristol, primary color)

interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  variant?: 'section-label' | 'page-heading' | 'body';
  className?: string;
}

const {
  level = 2,
  variant = 'body',
  className = '',
} = Astro.props;

// Capitalized variable name enables Astro dynamic tag rendering
const Tag = `h${level}` as any;

const variantClasses: Record<string, string> = {
  'section-label': 'text-xs font-semibold uppercase tracking-wider text-[#ff99d8]',
  'page-heading': 'text-3xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest',
  'body': 'text-xl font-heading font-bold text-primary',
};

const classes = `${variantClasses[variant]} ${className}`;
---

<Tag class={classes}>
  <slot />
</Tag>
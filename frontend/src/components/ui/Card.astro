---
// Card component — matches Figma:
// - Rounded corners (rounded-lg)
// - White bg with subtle border
// - Image on top, text below

interface Props {
  image?: string;
  alt?: string;
  aspectRatio?: string;
}

const {
  image,
  alt = 'Card image',
  aspectRatio = 'aspect-[4/3]',
} = Astro.props;
---

<div class="rounded-lg overflow-hidden border border-primary/20">
  {#if image}
    <div class={`${aspectRatio} bg-white`}>
      <img
        src={image}
        alt={alt}
        class="w-full h-full object-cover"
      />
    </div>
  {/if}
  <div class="p-5 bg-white border-t border-primary/10">
    <slot />
  </div>
</div>

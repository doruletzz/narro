---
// Card component with image, title, description, and optional link

interface Props {
  image?: string;
  imageUrl?: string;
  title?: string;
  description?: string;
  link?: string;
  linkText?: string;
  variant?: 'default' | 'hover-lift';
}

const {
  image,
  imageUrl,
  title,
  description,
  link,
  linkText = 'More',
  variant = 'default',
} = Astro.props;

const hoverClass = variant === 'hover-lift' ? 'hover:shadow-xl hover:-translate-y-1 transition-all duration-300' : '';
---

<article class={`bg-white rounded-lg shadow-md overflow-hidden ${hoverClass}`}>
  {(image || imageUrl) && (
    <div class="aspect-video overflow-hidden bg-neutral-100">
      <img
        src={imageUrl ?? image ?? ''}
        alt={title ?? 'Card image'}
        class="w-full h-full object-cover"
      />
    </div>
  )}
  <div class="p-6 space-y-3">
    {title && (
      <h3 class="text-lg font-bold text-neutral-900 font-heading">
        {link ? (
          <a href={link} class="hover:text-primary transition-colors">
            {title}
          </a>
        ) : (
          title
        )}
      </h3>
    )}
    {description && (
      <p class="text-sm text-neutral-600 leading-relaxed">{description}</p>
    )}
    {link && (
      <a
        href={link}
        class="inline-flex items-center text-sm font-medium text-primary hover:text-primary-dark transition-colors"
      >
        {linkText}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
    <slot />
  </div>
</article>

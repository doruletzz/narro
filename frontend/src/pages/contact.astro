---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Contact — Narro" description="Contactează-ne pentru proiecte de branding, design și comunicare vizuală. Da-ne un beep!">

  <!-- Da-ne un Beep Heading -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16">
    <!-- Sketch doodle decorations -->
    <div class="absolute top-8 left-8 w-72 pointer-events-none">
      <img src="/sketches/sketch-1.svg" />
    </div>
    <div class="absolute top-12 right-8 sm:right-16 w-72 pointer-events-none">
      <img src="/sketches/sketch-2.svg" />
    </div>
    <div class="absolute bottom-4 left-1/4 sm:left-[28%] w-72 pointer-events-none">
      <img src="/sketches/sketch-3.svg" />
    </div>
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest">DA-NE UN BEEP</h1>
    </div>
  </section>

  <!-- Contact Form Section — White box, thin borders, image with pink doodle -->
  <section class="px-4 sm:px-6 lg:px-8 pb-24">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
        <!-- Form — White box with clean thin borders -->
        <div class="bg-white p-8 md:p-10 rounded-lg">
          <p class="text-neutral-800 leading-relaxed mb-8 text-sm">
            Lorem ipsum dolor sit amet consectetur. Ut adipiscing risus mi quis magna etiam sem nunc. Magnis volutpat amet diam natoque nunc mattis amet bibendum risus.
          </p>
          <form class="space-y-4" aria-label="Formular de contact">
            <!-- Nume* -->
            <div>
              <label for="contact-name" class="sr-only">Nume*</label>
              <input
                id="contact-name"
                type="text"
                placeholder="Nume*"
                required
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-500 focus:outline-none focus:border-primary transition-colors text-sm"
              />
            </div>
            <!-- E-mail* -->
            <div>
              <label for="contact-email" class="sr-only">E-mail*</label>
              <input
                id="contact-email"
                type="email"
                placeholder="E-mail*"
                required
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-500 focus:outline-none focus:border-primary transition-colors text-sm"
              />
            </div>
            <!-- Business* -->
            <div>
              <label for="contact-business" class="sr-only">Business*</label>
              <input
                id="contact-business"
                type="text"
                placeholder="Business*"
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-500 focus:outline-none focus:border-primary transition-colors text-sm"
              />
            </div>
            <!-- Buget -->
            <div>
              <label for="contact-budget" class="sr-only">Buget</label>
              <select
                id="contact-budget"
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 focus:outline-none focus:border-primary transition-colors appearance-none text-sm"
              >
                <option value="" disabled selected>Buget</option>
                <option value="<5000">Sub 5.000 EUR</option>
                <option value="5000-10000">5.000 - 10.000 EUR</option>
                <option value="10000-20000">10.000 - 20.000 EUR</option>
                <option value=">20000">Peste 20.000 EUR</option>
              </select>
            </div>
            <!-- Care-i treaba? -->
            <div>
              <label for="contact-message" class="sr-only">Care-i treaba?</label>
              <textarea
                id="contact-message"
                placeholder="Care-i treaba?"
                rows={5}
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-500 focus:outline-none focus:border-primary transition-colors resize-none text-sm"
              ></textarea>
            </div>
            <!-- Submit -->
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-900 text-neutral-900 font-medium hover:bg-neutral-900 hover:text-white transition-colors rounded-none text-sm"
            >
              Trimite
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </button>
          </form>
        </div>
        <!-- Image — Old phones with sketch decorations -->
        <div class="relative bg-cream rounded-lg overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1558618666-fcd25c85f32e?w=700&q=80"
            alt="Contact — Da-ne un beep"
            class="w-full h-full object-cover"
          />
          <!-- Sketch doodle decorations -->
          <div class="absolute top-6 right-6 w-72 h-72 pointer-events-none">
            <img src="/sketches/sketch-4.svg" />
          </div>
          <div class="absolute bottom-6 left-6 w-72 h-72 pointer-events-none">
            <img src="/sketches/sketch-6.svg" />
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
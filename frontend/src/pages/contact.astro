---
import PageLayout from '../layouts/PageLayout.astro';
import Header from '../components/layouts/Header.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { Image } from 'astro:assets';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.contact.read();

if (!page) {
  throw new Error('Contact page content not found — fill it in at /keystatic');
}

const { title, description, heading, intro, form, image, imageAlt } = page;
---

<PageLayout title={title} description={description}>
  <Header />
  <!-- Contact Form Section — White box, thin borders, image with pink doodle -->
  <section class="px-4 sm:px-6 lg:px-8 py-12 relative min-h-screen">
    <div class="absolute -top-36 -left-24 sm:left-16 md:left-80 w-64 pointer-events-none doodle-scribble jitter-both jitter-delay-6" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-1.svg" />
    </div>
    <div class="absolute top-12 left-8 sm:block hidden sm:left-16 md:-left-20 w-64 pointer-events-none doodle-scribble jitter-both jitter-delay-1" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-8.svg" />
    </div>
    <div class="absolute top-1/4 left-3/4 md:left-1/3 w-72 pointer-events-none doodle-scribble jitter-both jitter-delay-2" style="transform: rotate(15deg);">
      <img src="/sketches/sketch-2.svg" />
    </div>
    <div class="absolute -top-20 -right-8 sm:right-20  w-64 pointer-events-none doodle-scribble jitter-both jitter-delay-3" style="transform: rotate(-25deg);">
      <img src="/sketches/sketch-6.svg" class=" hue-rotate-[220deg] contrast-150" />
    </div>
    <div class="absolute top-52 sm:-top-12 -left-12 sm:left-1/2 w-48 pointer-events-none doodle-scribble jitter-both jitter-delay-4">
      <img src="/sketches/sketch-4.svg" />
    </div>
    <div class="absolute top-44 sm:top-32   sm:block hidden right-4 sm:right-1/4 w-64 pointer-events-none doodle-scribble jitter-both jitter-delay-1" style="transform: rotate(20deg);">
      <img src="/sketches/sketch-8.svg"  class=" hue-rotate-[80deg] ml-20 contrast-150 brightness-90"  />
    </div>
    <div class="absolute top-44 sm:top-64 sm:block hidden right-4 sm:right-40 w-32 pointer-events-none doodle-scribble jitter-both jitter-delay-5" style="transform: rotate(20deg);">
      <img src="/sketches/sketch-2.svg"  class=" hue-rotate-[80deg] ml-20 contrast-150 brightness-90 scale-x-[-1]"  />
    </div>
    <div class="absolute bottom-48 sm:bottom-1/3 left-1/4 sm:-left-20 w-96 pointer-events-none doodle-scribble jitter-both jitter-delay-2" style="transform: rotate(8deg);">
      <img src="/sketches/sketch-1.svg"  class=" hue-rotate-[250deg] ml-20 contrast-150 brightness-120 scale-x-[-1] opacity-50" />
    </div>
    <div class="absolute bottom-12 sm:bottom-12 -left-4 sm:left-36 w-48 pointer-events-none doodle-scribble jitter-both jitter-delay-6" style="transform: rotate(8deg);">
      <img src="/sketches/sketch-3.svg" />
    </div>
    <div class="absolute bottom-12 sm:bottom-0 left-4 sm:block hidden sm:left-1/3 w-80 pointer-events-none doodle-scribble jitter-both jitter-delay-4" style="transform: rotate(8deg);">
      <img src="/sketches/sketch-6.svg" />
    </div>

    <div class="max-w-7xl mx-auto z-10">
      <div class="px-4 sm:px-6 lg:px-8 py-4 sm:py-12">
        <h2 class="active text-4xl font-heading font-bold text-center uppercase tracking-[0.2em]" style="color: #ff99d8;">{heading}</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Form — White box with clean thin borders -->
        <div class="bg-white p-6 md:p-10 rounded-2xl z-10">
          <p class="text-neutral-800 leading-relaxed mb-4 md:mb-8 md:text-lg">
            {intro}
          </p>
          <form class="space-y-4" aria-label="Formular de contact">
            <!-- Nume* -->
            <div>
              <label for="contact-name" class="sr-only">{form.nameLabel}</label>
              <input
                id="contact-name"
                type="text"
                placeholder={form.nameLabel}
                required
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors text-md"
              />
            </div>
            <!-- E-mail* -->
            <div>
              <label for="contact-email" class="sr-only">{form.emailLabel}</label>
              <input
                id="contact-email"
                type="email"
                placeholder={form.emailLabel}
                required
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors text-md"
              />
            </div>
            <!-- Business* -->
            <div>
              <label for="contact-business" class="sr-only">{form.businessLabel}</label>
              <input
                id="contact-business"
                type="text"
                placeholder={form.businessLabel}
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors text-md"
              />
            </div>
            <!-- Buget -->
            <div>
              <label for="contact-budget" class="sr-only">{form.budgetLabel}</label>
              <select
                required
                id="contact-budget"
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white valid:text-neutral-900 text-neutral-900/75 focus:outline-none focus:border-primary transition-colors appearance-none text-md"
              >
                <option value="" disabled selected>{form.budgetLabel}</option>
                {form.budgetOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <!-- Care-i treaba? -->
            <div>
              <label for="contact-message" class="sr-only">{form.messageLabel}</label>
              <textarea
                id="contact-message"
                placeholder={form.messageLabel}
                rows={5}
                class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors resize-none text-md"
              ></textarea>
            </div>
            <!-- Submit -->
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-900 text-neutral-900 font-medium hover:bg-neutral-900 hover:text-white transition-colors rounded-none text-md"
            >
              {form.submitLabel}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </button>
          </form>
        </div>
        <!-- Image — Old phones with sketch decorations -->
        <div class="relative bg-cream rounded-lg overflow-hidden">
          <Image
            src={image || ''}
            width={1920}
            height={1080}
            alt={imageAlt}
            class="w-full h-full object-cover"
          />
          <!-- Sketch doodle decorations -->
          <div class="absolute top-6 right-6 w-72 h-72 pointer-events-none">
            <img src="/sketches/sketch-4.svg" />
          </div>
          <div class="absolute bottom-6 left-6 w-72 h-72 pointer-events-none">
            <img src="/sketches/sketch-6.svg" />
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
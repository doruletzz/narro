---
import PageLayout from '../layouts/PageLayout.astro';
import Header from '../components/layouts/Header.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { Image } from 'astro:assets';
import ArrowIcon from '@/components/icons/ArrowIcon.astro';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.contact.read();

if (!page) {
  throw new Error('Contact page content not found — fill it in at /keystatic');
}

const { title, description, heading, intro, image, imageAlt } = page;
const formFields = page.form?.fields ?? [];
const submitLabel = page.form?.submitLabel ?? 'Trimite';
---

<PageLayout title={title} description={description}>
  <Header />
  <!-- Contact Form Section — White box, thin borders, image with pink doodle -->
  <section class="px-4 sm:px-6 lg:px-8 py-12 relative min-h-screen">
    <!-- Sketch doodle decorations — scattered, fade-in -->
    <div class="absolute -top-40 -left-32 w-72 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(-15deg);">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-8 sm:block hidden left-12 w-64 pointer-events-none doodle-scribble fade-in fade-delay-1" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[200deg] contrast-150" />
    </div>
    <div class="absolute -top-16 right-8 sm:right-16 md:right-40 w-64 pointer-events-none doodle-scribble fade-in fade-delay-5 md:block hidden" style="transform: rotate(-8deg);">
      <img src="/sketches/sketch-8.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-1/3 left-8 sm:left-16 w-48 pointer-events-none doodle-scribble fade-in fade-delay-4" style="transform: rotate(12deg);">
      <img src="/sketches/sketch-4.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-60 left-4 sm:left-12 w-64 pointer-events-none doodle-scribble fade-in fade-delay-6" style="transform: rotate(6deg);">
      <img src="/sketches/sketch-7.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 sm:bottom-0 left-8 sm:left-24 w-64 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(14deg);">
      <img src="/sketches/sketch-8.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-7xl mx-auto z-10">
      <div class="px-4 sm:px-6 lg:px-8 py-4 sm:py-12 md:mt-0 mt-10">
        <h2 class="active fade-in text-4xl font-heading font-bold text-center uppercase tracking-[0.2em]" style="color: #ff99d8;">{heading}</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Form — White box with clean thin borders -->
        <div class="md:order-1 order-2 bg-white p-6 md:p-10 rounded-2xl z-10 max-h-[48rem]">
          <p class="text-neutral-800 leading-relaxed mb-4 md:mb-8 md:text-lg fade-in">
            {intro}
          </p>
          {/* Web3Forms — action: https://web3forms.com */}
          <form action="https://web3forms.com/submit" method="POST" class="space-y-4" aria-label="Formular de contact">
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
            <input type="hidden" name="redirect" value="/contact?sent=success" />
            <input type="hidden" name="subject" value="Narro — Contact form" />
            {/* Honeypot — hidden spam protection. Bots fill this, humans don't see it. */}
            <input type="text" name="name" style="display:none" tabindex="-1" autocomplete="off" />
            {formFields.map((field, index) => (
              <div class={`fade-in fade-delay-${index + 2}`}>
                {/* {field.id} */}
                {field.type === 'select' ? (
                  <>
                    <label for={`contact-${field.id}`} class="sr-only">{field.label}</label>
                    <select
                      id={`contact-${field.id}`}
                      name={field.id}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white valid:text-neutral-900 text-neutral-900/75 focus:outline-none focus:border-primary transition-colors appearance-none text-md"
                    >
                      <option value="" disabled selected>{field.label}</option>
                      {(field.options ?? []).map((option) => (
                        <option value={option.value}>{option.label}</option>
                      ))}
                    </select>
                  </>
                ) : field.type === 'textarea' ? (
                  <>
                    <label for={`contact-${field.id}`} class="sr-only">{field.label}</label>
                    <textarea
                      id={`contact-${field.id}`}
                      name={field.id}
                      placeholder={field.label}
                      rows={5}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors resize-none text-md"
                    ></textarea>
                  </>
                ) : (
                  <>
                    <label for={`contact-${field.id}`} class="sr-only">{field.label}</label>
                    <input
                      id={`contact-${field.id}`}
                      name={field.id}
                      type={field.inputType || 'text'}
                      placeholder={field.label}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors text-md"
                    />
                  </>
                )}
              </div>
            ))}
            <!-- Submit -->
            <button
              type="submit"
              class={`inline-flex items-center gap-2 px-6 py-3 border border-neutral-900 text-neutral-900 font-medium hover:bg-neutral-900 hover:text-white transition-colors rounded-none text-md fade-in fade-delay-${formFields.length + 2}`}
            >
              {submitLabel}
              <ArrowIcon />
            </button>
          </form>
        </div>
        <!-- Image — Old phones with sketch decorations -->
        <div class="md:order-2 order-1 relative fade-in fade-delay-4 overflow-hidden max-h-[48rem] bg-white/30 rounded-xl md:my-0 -my-[26rem] md:mb-0 md:mx-0 -mx-12 md:z-0 -z-10">
          <Image
            src={image || ''}
            width={1920}
            height={1080}
            alt={imageAlt}
            class="w-full h-full object-cover  md:opacity-100 opacity-20"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Prefill select fields from query params (e.g. /contact?serviciu=Radiografia) —
       static build, so this must run client-side -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      document.querySelectorAll('form select').forEach((select) => {
        const param = params.get(select.name);
        if (!param) return;
        const match = Array.from(select.options).find((o) => o.value === param);
        if (match) select.value = param;
      });
    });
  </script>
</PageLayout>
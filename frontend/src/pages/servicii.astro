---
import PageLayout from '@/layouts/PageLayout.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import ServiceCard from '@/components/sections/ServiceCard.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { parseMarkdown } from '@/lib/markdown-utils';
import Header from '@/components/layouts/Header.astro';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.servicii.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Servicii content not found — fill it in at /keystatic');
}

const { intro, proiectDeBrand, categories, finePrint, cta } = page;
const { ctaBanner } = home || {};

// Slugify helper for section anchors
const slugify = (text: string) =>
  text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-');

// Split the intro text into words with staggered animation delays
const introWords = (intro || '').split(' ').filter(Boolean);
---

<PageLayout title="Servicii — Narro" description={intro}>
  <style>
    /* Service accordion (inside categories) */
    .service-card {
      opacity: 0;
      cursor: pointer;
      transition: flex 1.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .service-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 2.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .service-card.is-active .service-body {
      grid-template-rows: 1fr;
    }

    .service-body-inner {
      overflow: hidden;
    }

    .service-icon {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .service-card.is-active .service-icon {
      transform: rotate(45deg);
    }

    /* Category image swap */
    .cat-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      display: none;
      transition: opacity 0.7s ease;
    }

    .cat-img.is-active {
      display: block;
      opacity: 1;
    }
  </style>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Intersection Observer for doodle animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.doodle-scribble').forEach((el) => observer.observe(el));

    // Service accordion + image swap logic
    const servicesWrappers = document.querySelectorAll('.services-accordion-wrapper');
    servicesWrappers.forEach((servicesWrapper) => {
      const serviceCards = servicesWrapper.querySelectorAll('.service-card');
      if (serviceCards.length === 0) return;

      // Find images in the SAME category row (parent of servicesWrapper)
      const catFlexRow = servicesWrapper.closest('.flex.gap-4');
      const catImgs = catFlexRow ? catFlexRow.querySelectorAll('.cat-img') : [];

      // Single service: auto-open
      if (serviceCards.length === 1) {
        serviceCards[0].classList.add('is-active');
        if (catImgs.length > 0) catImgs[0].classList.add('is-active');
        return;
      }

      const DEFAULT_ACTIVE_INDEX = 0;
      let hoverTimeout = null; // Timer reference scoped to this accordion instance

      const setActiveService = (index) => {
        serviceCards.forEach((card, i) => card.classList.toggle('is-active', i === index));
        catImgs.forEach((img, i) => img.classList.toggle('is-active', i === index));
      };

      serviceCards.forEach((card, index) => {
        card.addEventListener('mouseenter', () => {
          if (window.innerWidth < 768) return;

          // Clear any pending state reset or card switch
          clearTimeout(hoverTimeout);

          // Delay execution by 100ms to ignore accidental mouse passes
          hoverTimeout = setTimeout(() => {
            setActiveService(index);
          }, 100);
        });

        card.addEventListener('click', (e) => {
          if (window.innerWidth >= 768 || e.target.closest('a')) return;
          setActiveService(index);
        });
      });

      // servicesWrapper.addEventListener('mouseleave', () => {
      //   if (window.innerWidth < 768) return;

      //   // Clear active hover timeout
      //   clearTimeout(hoverTimeout);

      //   // Delay reverting to default so brief exits don't flash
      //   hoverTimeout = setTimeout(() => {
      //     setActiveService(DEFAULT_ACTIVE_INDEX);
      //   }, 100);
      // });

      setActiveService(DEFAULT_ACTIVE_INDEX);
    });
  });
</script>

  <Header />
  <!-- ===== Intro Section ===== -->
  <section class="relative overflow-hidden px-4 py-24 lg:py-32 bg-[#f5f0eb]">
    <div class="absolute -bottom-24 sm:block hidden -left-12 sm:left-16 md:left-56 w-64 pointer-events-none doodle-scribble fade-in fade-delay-6" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-1.svg" alt="" />
    </div>
    <div class="absolute top-12 left-8 sm:block hidden sm:left-16 md:-left-20 w-64 pointer-events-none doodle-scribble fade-in fade-delay-1" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-8.svg" alt="" />
    </div>
    <div class="absolute bottom-1/4 left-3/4 md:left-1/3 w-72 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(15deg);">
      <img src="/sketches/sketch-2.svg" alt="" />
    </div>
    <div class="absolute -top-12   left-1/4 md:left-1/4 w-96 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(15deg);">
      <img src="/sketches/sketch-5.svg" alt="" class="scale-125" />
    </div>
    <div class="absolute -bottom-20 -right-8 sm:block hidden sm:right-20 w-64 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(-25deg);">
      <img src="/sketches/sketch-6.svg" alt="" class="hue-rotate-[220deg] contrast-150" />
    </div>
    <div class="absolute bottom-52 sm:-top-12 -left-12 sm:left-1/2 w-48 pointer-events-none doodle-scribble fade-in fade-delay-4">
      <img src="/sketches/sketch-4.svg" alt="" />
    </div>
    <div class="absolute bottom-44 sm:bottom-32 sm:block hidden right-4 sm:right-1/4 w-40 pointer-events-none doodle-scribble fade-in fade-delay-1" style="transform: rotate(20deg);">
      <img src="/sketches/sketch-8.svg" alt="" class="hue-rotate-[80deg] -ml-10 mb-4 contrast-150 brightness-90" />
    </div>
    <div class="absolute bottom-44 sm:bottom-64 sm:block hidden right-4 sm:right-40 w-32 pointer-events-none doodle-scribble fade-in fade-delay-5" style="transform: rotate(20deg);">
      <img src="/sketches/sketch-2.svg" alt="" class="hue-rotate-[80deg] ml-20 contrast-150 brightness-90 scale-x-[-1]" />
    </div>
    <div class="max-w-7xl mx-auto relative z-10 min-h-[30vh] my-auto">
      <h1 class="md:text-5xl text-4xl flex flex-wrap justify-center sm:text-6xl md:max-w-3xl lg:text-7xl xl:text-7xl xl:max-w-full font-heading font-extrabold lg:!leading-[1.05] md:tracking-tight tracking-tighter" style="color: #2200d8;">
        {introWords.map((word, i) => (
          <span class="inline-block fade-in" style={`animation-delay: ${-210 + i * 110}ms;`}>{word}&nbsp;</span>
        ))}
      </h1>
    </div>
  </section>

  <!-- ===== Proiectul de Brand (featured) ===== -->
  <section id={slugify(proiectDeBrand.title)} class="relative overflow-hidden px-4 py-12 lg:py-24 bg-white scroll-mt-24 ">
    <div class="max-w-4xl mx-auto">
      <div class:list={['service-card fade-in  bg-[#f5f0eb] rounded-xl p-5 overflow-hidden [&.is-active]:flex-1 flex-grow-0', 'is-active', 'fade-delay-2']}>
                      <div class="flex items-center justify-between gap-4">
                        <h4 class="text-2xl font-heading font-semibold" style="color: #2200d8;">{proiectDeBrand.title}</h4>
                      </div>
                      <div class="service-body h-full">
                        <div class="service-body-inner">
                            {proiectDeBrand.price && (
                              <span class="inline-block my-3 bg-primary/10 text-neutral-900 font-semibold px-4 py-1 text-lg md:text-lg rounded-full ">{proiectDeBrand.price}</span>
                            )}
                          <div class="space-y-3 pt-3">
                            {proiectDeBrand.lead && (
                              <p class="text-xl font-semibold text-neutral-900 max-w-md">{proiectDeBrand.lead}</p>
                            )}
                            {proiectDeBrand.paragraphs?.map((p) => (
                              <p set:html={parseMarkdown(p)} class="text-md text-neutral-700 leading-relaxed max-w-2xl mb-24" />
                            ))}
                            {proiectDeBrand.primestiLabel && proiectDeBrand.primesti && proiectDeBrand.primesti.length > 0 && (
                              <>
                                <p class="font-semibold text-neutral-900 mb-1 pt-4">{proiectDeBrand.primestiLabel}</p>
                                <ul class="list-disc pl-5 space-y-0.5 text-md text-neutral-700 grid grid-cols-2 pb-12">
                                  {proiectDeBrand.primesti.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </>
                            )}
                          </div>
                        </div>

                            <a
                              href={`/contact?serviciu=${encodeURIComponent(proiectDeBrand.title)}`}
                              class="inline-flex items-center gap-2 px-5 py-2 pt-2.5 text-sm bg-white w-fit mt-4 font-medium text-neutral-900 border border-[#FF66C4] rounded-full hover:border-[#2200d8] hover:bg-[#2200d8] hover:text-white transition-colors tracking-wide group/cta"
                            >
                              CONTACTEAZA-NE
                              <svg class="w-4 h-4 mb-0.5 group-hover/cta:rotate-45 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
                              </svg>
                            </a>
                      </div>
                    </div>
  </section>

  <!-- ===== Categories Stack (each category with title + image, services accordion inside) ===== -->
  <section id="categorii" class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-12 sm:py-20 lg:py-24 bg-[#f5f0eb] scroll-mt-24">
    <!-- Sketch doodle decorations -->
    <div class="absolute top-6 left-full sm:-left-12 w-64 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-6.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-16 right-0 sm:right-32 w-72 pointer-events-none doodle-scribble fade-in fade-delay-5 sm:block hidden" style="transform: rotate(15deg);">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[190deg] contrast-150 brightness-110" />
    </div>
    <div class="absolute -top-10 left-2 sm:left-1/2 w-96 pointer-events-none doodle-scribble fade-in fade-delay-7" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[230deg] contrast-150 brightness-120 scale-x-[-1] opacity-50" />
    </div>
    <div class="absolute bottom-1/4 right-4 sm:right-20 w-48 pointer-events-none doodle-scribble fade-in fade-delay-4" style="transform: rotate(-8deg);">
      <img src="/sketches/sketch-2.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-6xl mx-auto ">
      <div id="categories-stack-wrapper" class="categories-stack-wrapper flex flex-col gap-12 md:gap-20">
        {categories?.map((cat, catIndex) => {
          const firstService = cat.services?.[0];
          const hasImage = firstService?.image;
          const numServices = cat.services?.length ?? 0;
          const singleService = numServices < 2;
          const fadeDelay = catIndex * 2 + 2;

          return (
            <div class:list={['fade-in', 'fade-delay-' + fadeDelay]}>
              <h2 class="fade-in text-3xl md:text-4xl font-heading items-stretch font-bold uppercase tracking-[0.2em] mb-4" style="color: #ff99d8;">{cat.name}</h2>
      
              <!-- Category intro -->
              {cat.intro && (
                <p class="text-neutral-700 leading-relaxed mb-4 max-w-lg">{cat.intro}</p>
              )}
              <div class={`flex gap-4 flex-col   ${catIndex % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse "}`}>
                <!-- Services accordion -->
                <div id="services-accordion-wrapper" class="services-accordion-wrapper flex flex-col gap-3 min-h-[32rem]">
                  {cat.services?.map((service, sIndex) => (
                    <div class:list={['service-card fade-in bg-white rounded-xl p-5 overflow-hidden [&.is-active]:flex-1 flex-grow-0', singleService && 'is-active', 'fade-delay-' + (catIndex * 2 + sIndex + 3)]}>
                      <div class="flex items-center justify-between gap-4">
                        <h4 class="text-2xl font-heading font-semibold" style="color: #2200d8;">{service.title}</h4>
                        {!singleService && <svg class="service-icon w-5 h-5 flex-shrink-0" fill="none" stroke="#2200d8" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14" />
                        </svg>}
                      </div>
                      <div class="service-body h-full">
                        <div class="service-body-inner">
                          <div class="space-y-3 pt-3">
                            {service.price && (
                              <span class="inline-block bg-primary/10 text-neutral-900 font-semibold px-5 py-1 text-lg md:text-lg rounded-full pb-0.5">{service.price}</span>
                            )}
                            {service.lead && (
                              <p class="text-xl max-w-sm font-semibold text-neutral-900">{service.lead}</p>
                            )}
                            {service.paragraphs?.map((p) => (
                              <p set:html={parseMarkdown(p)} class="text-md text-neutral-700 leading-relaxed" />
                            ))}
                            {service.primestiLabel && service.primesti && service.primesti.length > 0 && (
                              <>
                                <p class="font-semibold text-neutral-900 mt-2 mb-1">{service.primestiLabel}</p>
                                <ul class="list-disc pl-5 space-y-0.5 text-md text-neutral-700 grid grid-cols-1">
                                  {service.primesti.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </>
                            )}
                            {service.primestiInline && (
                              <p class="text-sm text-neutral-700">{service.primestiInline}</p>
                            )}
                            {service.note && (
                              <p class="mt-2 text-sm text-neutral-500">{service.note}</p>
                            )}
                            {service.tiers && service.tiers.length > 0 && (
                              <div class="grid grid-cols-1 gap-4 mt-3">
                                {service.tiers.map((tier) => (
                                  <div class="bg-white border-b rounded-xl last:border-none hover:bg-black/5 border-neutral-200">
                                    <p class="font-heading font-bold text-md text-accent">{tier.name}</p>
                                    <p class="font-semibold mt-1 text-xs">{tier.price}</p>
                                    <p class="text-md text-neutral-600 mt-1 leading-relaxed">{tier.details}</p>
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>
                            <a
                              href={`/contact?serviciu=${encodeURIComponent(service.title)}`}
                              class="inline-flex items-center gap-2 px-5 py-2 pt-2.5 text-sm mt-4 font-medium text-neutral-900 border border-[#FF66C4] rounded-full hover:border-[#2200d8] hover:bg-[#2200d8] hover:text-white transition-colors tracking-wide group/cta"
                            >
                              CONTACTEAZA-NE
                              <svg class="w-4 h-4 mb-0.5 group-hover/cta:rotate-45 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
                              </svg>
                            </a>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

              <!-- Right: category images (one per service, swaps on hover) -->
                <div class="w-full">
                  <div class="relative h-full md:min-h-[32rem] min-h-80 overflow-hidden rounded-xl">
                    {cat.services?.filter(s => s.image).map((service, imgIndex) => (
                          <img
                            src={service.image}
                            alt={service.imageAlt || service.title || cat.name}
                            loading={imgIndex === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                            class:list={['cat-img', singleService && 'is-active']}
                          />
                    ))}
                  </div>
                </div>
              </div>

            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ===== Fine Print ===== -->
  {finePrint && (
    <section class="relative overflow-hidden px-4 py-12 bg-white">
      <div class="md:px-8 px-2 mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xl text-neutral-700">
          {finePrint.sedinte && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-6 text-2xl" style="color: #ff99d8;">{finePrint.sedinte.label}</p>
              <ul class="space-y-1 list-disc pl-5">
                {finePrint.sedinte.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {finePrint.separat && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-6 text-2xl" style="color: #ff99d8;">{finePrint.separat.label}</p>
              <ul class="space-y-1 list-disc pl-5">
                {finePrint.separat.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {finePrint.conditii && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-6 text-2xl" style="color: #ff99d8;">{finePrint.conditii.label}</p>
              <ul class="space-y-1.5 list-none">
                {finePrint.conditii.items?.map((item) => (
                  <li set:html={parseMarkdown(item)} />
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>

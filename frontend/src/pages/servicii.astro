---
import PageLayout from '@/layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Slider from '@/components/ui/Slider.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// NOTE: Keystatic stores uploads in public/ (root-relative paths), and
// Astro's <Image> component can't process public/ assets — only imported
// images or remote URLs. So these CMS images stay as plain <img> tags.

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.servicii.read();

if (!page) {
  throw new Error('Servicii content not found — fill it in at /keystatic');
}

const { cele3Directii, oferte } = page;
const DEFAULT_DIRECTIE_INDEX = 1; // Middle card stays open/centered by default.
---

<PageLayout title="Servicii — Narro" description="Cele 3 direcții: Branding, Social Media, Continut Foto-Video. Oferim soluții complete de branding și comunicare.">
  <style>
    /* Desktop Smooth Transition Rules */
    @media (min-width: 768px) {
      .directii-card {
        flex: 1 1 0%;
        transition:
          flex 2.3s cubic-bezier(0.16, 1, 0.3, 1),
          opacity 0.5s ease,
          transform 2.3s cubic-bezier(0.16, 1, 0.3, 1),
          background 1.3s cubic-bezier(0.16, 1, 0.3, 1);
        opacity: 0.6;
        will-change: flex, transform, opacity, background;
        transform: scale(1);
      }

      .directii-card .card-img-wrapper {
        aspect-ratio: 3 / 4;
        transition: aspect-ratio 1s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .directii-card.is-active {
        flex: 1.8 1 0%;
        opacity: 1;
        transform: scale(1.05);
      }

      .directii-card.is-active .card-img-wrapper {
        aspect-ratio: 6 / 4;
      }
    }

    /* Mobile: fixed-width swipeable cards (snap handled by the Slider component) */
    @media (max-width: 767px) {
      .directii-card {
        flex: 0 0 82vw;
        transition: transform 2.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
        opacity: 0.6;
        transform: scale(0.94);
      }

      .directii-card .card-img-wrapper {
        aspect-ratio: 3 / 4;
        transition: aspect-ratio 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .directii-card.is-active {
        opacity: 1;
        transform: scale(1);
      }

      .directii-card.is-active .card-img-wrapper {
        aspect-ratio: 6 / 4;
      }
    }

    /* Offers accordion (mirrors card stack behavior) */
    .oferta-card {
      opacity: 0.55;
      cursor: pointer;
      transition: opacity 0.5s ease;
    }

    .oferta-card.is-active {
      opacity: 1;
    }

    .oferta-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .oferta-card.is-active .oferta-body {
      grid-template-rows: 1fr;
    }

    .oferta-body-inner {
      overflow: hidden;
    }

    .oferta-icon {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .oferta-card.is-active .oferta-icon {
      transform: rotate(45deg);
    }

    .oferta-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1);
      opacity: 0;
      transition: opacity 0.7s ease;
    }

    .oferta-img.is-active {
      opacity: 1;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Intersection Observer for doodle animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.doodle-scribble').forEach((el) => observer.observe(el));

      // Card active-switching logic
      const wrapper = document.getElementById('directii-wrapper');
      if (wrapper) {
        const cards = wrapper.querySelectorAll('.directii-card');
        const DEFAULT_ACTIVE_INDEX = Number(wrapper.dataset.defaultActive ?? 0);

        const setActiveCard = (index) => {
          cards.forEach((card, i) => card.classList.toggle('is-active', i === index));
        };

        // Desktop hover: activate hovered card, reset to default on leave.
        cards.forEach((card, index) => {
          card.addEventListener('mouseenter', () => {
            if (window.innerWidth >= 768) setActiveCard(index);
          });
        });
        wrapper.addEventListener('mouseleave', () => {
          if (window.innerWidth >= 768) setActiveCard(DEFAULT_ACTIVE_INDEX);
        });

        // Mobile swipe: activate whichever card is centered in the snap viewport.
        const mobileObserver = new IntersectionObserver((entries) => {
          if (window.innerWidth >= 768) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActiveCard(Array.from(cards).indexOf(entry.target));
          });
        }, { root: wrapper, threshold: 0.65 });

        cards.forEach((card) => mobileObserver.observe(card));
      }

      // Offers accordion logic (mirrors card stack)
      const oferteWrapper = document.getElementById('oferte-wrapper');
      if (oferteWrapper) {
        const oferteCards = oferteWrapper.querySelectorAll('.oferta-card');
        const oferteImgs = document.querySelectorAll('.oferta-img');
        const DEFAULT_OFERTA_INDEX = 0;

        const setActiveOferta = (index) => {
          oferteCards.forEach((card, i) => card.classList.toggle('is-active', i === index));
          oferteImgs.forEach((img, i) => img.classList.toggle('is-active', i === index));
        };

        oferteCards.forEach((card, index) => {
          card.addEventListener('mouseenter', () => {
            if (window.innerWidth >= 768) setActiveOferta(index);
          });
          card.addEventListener('click', (e) => {
            if (window.innerWidth >= 768 || e.target.closest('a')) return;
            setActiveOferta(index);
          });
        });
        oferteWrapper.addEventListener('mouseleave', () => {
          if (window.innerWidth >= 768) setActiveOferta(DEFAULT_OFERTA_INDEX);
        });
      }
    });
  </script>

  <Header />

  <!-- ===== CELE 3 DIRECTII Section ===== -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24" style="background-color: #f5f0eb;">
    <div class="absolute top-4 left-2 sm:left-6 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 right-4 sm:right-12 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-6xl mx-auto relative z-10">
      <h2 class="text-xl sm:text-2xl font-heading font-bold uppercase tracking-[0.2em] mb-8 sm:mb-10 text-center sm:text-left" style="color: #ff99d8;">
        {cele3Directii.label}
      </h2>

      <Slider id="directii-wrapper" data-default-active={DEFAULT_DIRECTIE_INDEX} class="md:overflow-visible" snap={false}>
        {cele3Directii.cards.map((directie, index) => (
          <div class:list={['directii-card flex flex-col cursor-pointer p-2 hover:bg-white rounded-xl transition-colors', index === DEFAULT_DIRECTIE_INDEX && 'is-active']}>
            <div class="card-img-wrapper h-[24rem] rounded-lg overflow-hidden border-2 bg-white w-full" style="border-color: #2200d8;">
              <img src={directie.image} alt={directie.imageAlt} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
            <div class="mt-4">
              <h3 class="text-lg font-heading font-bold mb-1" style="color: #2200d8;">{directie.title}</h3>
              <p class="text-xs text-neutral-600 leading-relaxed max-w-xs">{directie.description}</p>
            </div>
          </div>
        ))}
      </Slider>
    </div>
  </section>

  <!-- ===== OFERTE SI OFERTE Section ===== -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24" style="background-color: #f5f0eb;">
    <div class="absolute top-8 sm:top-12 right-2 sm:right-10 md:right-16 w-80 pointer-events-none doodle-scribble" style="transform: rotate(-5deg);">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-12 left-4 sm:left-12 w-72 pointer-events-none doodle-scribble">
      <img src="/sketches/sketch-2.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-6xl mx-auto">
      <h2 class="text-xl sm:text-2xl font-heading font-bold uppercase tracking-[0.2em] mb-8 sm:mb-10 text-center" style="color: #ff99d8;">{oferte.label}</h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <!-- Left: expandable offer accordion -->
        <div id="oferte-wrapper" class="oferte-wrapper flex flex-col gap-3">
          {oferte.items.map((oferta, index) => (
            <div class:list={['oferta-card bg-white rounded p-6 sm:p-8', index === 0 && 'is-active']}>
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-xl sm:text-2xl font-heading font-bold" style="color: #2200d8;">{oferta.title}</h3>
                <svg class="oferta-icon w-5 h-5 flex-shrink-0" fill="none" stroke="#2200d8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14" />
                </svg>
              </div>
              <div class="oferta-body">
                <div class="oferta-body-inner">
                  <div class="space-y-4 pt-4">
                    {oferta.paragraphs.map((paragraph) => (
                      <p class="text-sm text-neutral-700 leading-relaxed">{paragraph}</p>
                    ))}
                    <a href={oferta.ctaHref} class="inline-flex items-center gap-1 px-4 py-2 border text-sm font-medium transition-colors hover:bg-[#2200d8] hover:text-white rounded" style="border-color: #2200d8; color: #2200d8;">
                      {oferta.ctaLabel}
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Right: B&W photo that swaps per active offer -->
        <div class="relative h-full min-h-[20rem] overflow-hidden rounded">
          {oferte.items.map((oferta, index) => (
            <img
              src={oferta.image}
              alt={oferta.title}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class:list={['oferta-img', index === 0 && 'is-active']}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</PageLayout>
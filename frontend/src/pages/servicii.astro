---
import PageLayout from '@/layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import ArrowIcon from '@/components/icons/ArrowIcon.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { parseMarkdown } from '@/lib/markdown-utils';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.servicii.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Servicii content not found — fill it in at /keystatic');
}

const { intro, proiectDeBrand, categories, finePrint, cta } = page;
const { ctaBanner } = home || {};

// Slugify helper for section anchors
const slugify = (text: string) =>
  text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-');

// Split the intro text into words with staggered animation delays
const introWords = (intro || '').split(' ').filter(Boolean);
const totalIntroWords = introWords.length;

// Determine how many categories we have (for accordion behavior)
const numCategories = categories?.length ?? 0;
const singleCategory = numCategories <= 1;
---

<PageLayout title="Servicii — Narro" description={intro}>
  <style>
    /* Accordion animation */
    .cat-card {
      opacity: 0;
      cursor: pointer;
    }

    .cat-body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cat-card.is-active .cat-body {
      grid-template-rows: 1fr;
    }

    .cat-body-inner {
      overflow: hidden;
    }

    .cat-icon {
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cat-card.is-active .cat-icon {
      transform: rotate(45deg);
    }

    /* Category image swap */
    .cat-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.7s ease;
    }

    .cat-img.is-active {
      opacity: 1;
    }

    /* Categories: hover image appearance */
    .categories-image-col {
      position: relative;
      transition: opacity 0.5s ease;
    }

    .categories-image-col img {
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .categories-image-col.has-image img {
      opacity: 1;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Intersection Observer for doodle animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.doodle-scribble').forEach((el) => observer.observe(el));

      // Accordion logic (mirrors previous oferte behavior)
      const catWrapper = document.getElementById('categories-accordion-wrapper');
      if (catWrapper) {
        const catCards = catWrapper.querySelectorAll('.cat-card');
        const catImgs = document.querySelectorAll('.cat-img');
        const numCats = catCards.length;
        const DEFAULT_ACTIVE_INDEX = singleCategory ? 0 : -1;

        const setActiveCat = (index) => {
          catCards.forEach((card, i) => card.classList.toggle('is-active', i === index));
          catImgs.forEach((img, i) => img.classList.toggle('is-active', i === index));
        };

        catCards.forEach((card, index) => {
          // Desktop hover: activate hovered card
          card.addEventListener('mouseenter', () => {
            if (window.innerWidth >= 768) setActiveCat(index);
          });

          // Mobile click: toggle active
          card.addEventListener('click', (e) => {
            if (window.innerWidth >= 768) return;
            setActiveCat(index);
          });
        });

        catWrapper.addEventListener('mouseleave', () => {
          if (window.innerWidth >= 768) setActiveCat(DEFAULT_ACTIVE_INDEX);
        });
      }
    });
  </script>

  <!-- ===== Intro Section ===== -->
  <section class="relative overflow-hidden px-4 py-24 lg:py-32 bg-[#f5f0eb]">
    <div class="max-w-7xl mx-auto relative z-10">
      <h1 class="text-5xl flex flex-wrap justify-center sm:text-6xl md:max-w-3xl md:text-7xl xl:text-7xl xl:max-w-full font-heading font-extrabold lg:!leading-[0.95] md:tracking-tight tracking-tighter" style="color: #2200d8;">
        {introWords.map((word, i) => (
          <span class="inline-block fade-in" style={`animation-delay: ${-210 + i * 110}ms;`}>{word}&nbsp;</span>
        ))}
      </h1>
    </div>
    <!-- doodle -->
    <div class="absolute top-12 right-0 sm:right-16 w-48 pointer-events-none doodle-scribble fade-in fade-delay-3">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- ===== Proiectul de Brand (featured) ===== -->
  <section id={slugify(proiectDeBrand.title)} class="relative overflow-hidden px-4 py-20 lg:py-28 bg-white scroll-mt-24">
    <!-- doodle -->
    <div class="absolute -top-12 -left-16 w-64 pointer-events-none doodle-scribble fade-in fade-delay-2">
      <img src="/sketches/sketch-4.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 right-0 sm:right-8 w-72 pointer-events-none doodle-scribble fade-in fade-delay-4">
      <img src="/sketches/sketch-6.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[80deg] contrast-150 brightness-120" />
    </div>
    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl border-2 border-[#2200d8] p-6 md:p-10 lg:p-14 shadow-none">
        <h2 class="fade-in text-5xl sm:text-6xl md:text-7xl font-heading font-extrabold lg:!leading-[0.85] md:tracking-tight tracking-tighter" style="color: #2200d8;">{proiectDeBrand.title}</h2>
        <p class="text-lg md:text-xl font-semibold text-neutral-900 mb-5">{proiectDeBrand.lead}</p>
        {proiectDeBrand.paragraphs?.map((p) => (
          <p set:html={parseMarkdown(p)} class="text-neutral-700 leading-relaxed mb-4" />
        ))}
        {proiectDeBrand.primestiLabel && proiectDeBrand.primesti && proiectDeBrand.primesti.length > 0 && (
          <>
            <p class="font-semibold text-neutral-900 mt-8 mb-3">{proiectDeBrand.primestiLabel}</p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-6 text-neutral-700">
              {proiectDeBrand.primesti.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 flex-shrink-0 rounded-full" style="background-color: #2200d8;"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        {proiectDeBrand.closing && (
          <p set:html={parseMarkdown(proiectDeBrand.closing)} class="text-neutral-700 leading-relaxed mb-6" />
        )}
        {proiectDeBrand.price && (
          <span class="inline-block bg-[#ffb6e8] text-neutral-900 font-semibold px-4 py-2 text-sm md:text-base rounded-full">{proiectDeBrand.price}</span>
        )}
      </div>
    </div>
  </section>

  <!-- ===== Categories Accordion (replaces previous "oferte si oferte") ===== -->
  <section id={categories && categories.length > 0 ? slugify(categories[0].name) : 'categorii'} class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-12 sm:py-20 lg:py-24 bg-[#f5f0eb] scroll-mt-24">
    <!-- Sketch doodle decorations — scattered, fade-in -->
    <div class="absolute top-6 left-full sm:-left-12 w-64 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-6.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-16 right-0 sm:right-32 w-72 pointer-events-none doodle-scribble fade-in fade-delay-5 sm:block hidden" style="transform: rotate(15deg);">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[190deg] contrast-150 brightness-110" />
    </div>
    <div class="absolute -top-10 left-2 sm:left-1/2 w-96 pointer-events-none doodle-scribble fade-in fade-delay-7" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[230deg] contrast-150 brightness-120 scale-x-[-1] opacity-50" />
    </div>
    <div class="absolute bottom-1/4 right-4 sm:right-20 w-48 pointer-events-none doodle-scribble fade-in fade-delay-4" style="transform: rotate(-8deg);">
      <img src="/sketches/sketch-2.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-6xl mx-auto">
      <h2 class="active fade-in text-4xl font-heading font-bold text-center mb-4 md:mb-8 uppercase tracking-[0.2em]" style="color: #ff99d8;">{categories?.[0]?.name || 'Categorii'}</h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <!-- Left: expandable accordion -->
        <div id="categories-accordion-wrapper" class="categories-accordion-wrapper flex flex-col gap-3">
          {categories?.map((cat, index) => (
            <div class:list={['cat-card fade-in bg-white rounded-2xl p-6 sm:p-8', singleCategory && 'is-active', `fade-delay-${index + 2}`]}>
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-2xl font-heading font-bold" style="color: #2200d8;">{cat.name}</h3>
                <svg class="cat-icon w-5 h-5 flex-shrink-0" fill="none" stroke="#2200d8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14" />
                </svg>
              </div>
              <div class="cat-body">
                <div class="cat-body-inner">
                  <div class="space-y-4 pt-4">
                    {cat.intro && (
                      <p set:html={parseMarkdown(cat.intro)} class="text-sm text-neutral-700 leading-relaxed" />
                    )}
                    {cat.services?.map((service) => (
                      <div class="border-t border-neutral-200 pt-3 mt-2 first:border-t-0 first:pt-0 first:mt-0">
                        <h4 class="font-semibold text-neutral-900 mb-1">{service.title}</h4>
                        {service.lead && (
                          <p class="text-sm text-neutral-600 mb-1">{service.lead}</p>
                        )}
                        {service.paragraphs?.map((p) => (
                          <p set:html={parseMarkdown(p)} class="text-sm text-neutral-700 leading-relaxed" />
                        ))}
                        {service.primestiLabel && service.primesti && service.primesti.length > 0 && (
                          <>
                            <p class="font-semibold text-neutral-900 mt-3 mb-1">{service.primestiLabel}</p>
                            <ul class="list-disc pl-5 space-y-0.5 text-sm text-neutral-700">
                              {service.primesti.map((item) => (
                                <li>{item}</li>
                              ))}
                            </ul>
                          </>
                        )}
                        {service.primestiInline && (
                          <p class="text-sm text-neutral-700 mt-2">{service.primestiInline}</p>
                        )}
                        {service.price && (
                          <span class="inline-block bg-[#ffb6e8] text-neutral-900 font-semibold px-3 py-1 text-xs md:text-sm rounded-full mt-2">{service.price}</span>
                        )}
                        {service.note && (
                          <p class="mt-2 text-xs text-neutral-500">{service.note}</p>
                        )}
                        {service.tiers && service.tiers.length > 0 && (
                          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
                            {service.tiers.map((tier) => (
                              <div class="bg-[#f5f0eb] rounded-lg p-3">
                                <p class="font-heading font-bold text-sm" style="color: #2200d8;">{tier.name}</p>
                                <p class="font-semibold mt-1 text-xs">{tier.price}</p>
                                <p class="text-xs text-neutral-600 mt-1 leading-relaxed">{tier.details}</p>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Right: image that swaps per active category -->
        <div class="relative h-full min-h-[20rem] overflow-hidden rounded">
          {categories?.map((cat, index) => {
            const hasImage = cat.services?.[0]?.image;
            if (!hasImage) return null;
            return (
              <img
                src={cat.services[0].image}
                alt={cat.services[0].imageAlt || cat.name}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class:list={['cat-img', singleCategory && 'is-active']}
              />
            );
          })}
          {numCategories === 0 && (
            <div class="w-full h-full bg-neutral-200 rounded flex items-center justify-center text-neutral-500">
              Niciun serviciu
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Fine Print ===== -->
  {finePrint && (
    <section class="relative overflow-hidden px-4 py-16 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-neutral-700">
          {finePrint.sedinte && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-2 text-xs" style="color: #ff99d8;">{finePrint.sedinte.label}</p>
              <ul class="space-y-1 list-disc pl-5">
                {finePrint.sedinte.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {finePrint.separat && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-2 text-xs" style="color: #ff99d8;">{finePrint.separat.label}</p>
              <ul class="space-y-1 list-disc pl-5">
                {finePrint.separat.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          {finePrint.conditii && (
            <div>
              <p class="font-heading font-bold uppercase tracking-wide mb-2 text-xs" style="color: #ff99d8;">{finePrint.conditii.label}</p>
              <ul class="space-y-1.5 list-none">
                {finePrint.conditii.items?.map((item) => (
                  <li set:html={parseMarkdown(item)} />
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ===== CTA ===== -->
  {cta && (
    <CtaBanner ctaBanner={{
      image: '',
      imageAlt: '',
      description: cta.description,
      text: cta.text,
      href: cta.href,
    }} />
  )}

  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>

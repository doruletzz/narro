          <div class="aspect-[4/3]">
            <!-- TODO: Replace with Figma asset — purple tech graphics with "Take what you need" -->
            <img
              src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=600&q=80"
              alt="Continut Foto-Video — Content creation"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-4 sm:p-5" style="background-color: #f5f0eb;">
            <p class="text-[10px] sm:text-xs uppercase tracking-wide mb-1" style="color: #2200d8; opacity: 0.5;">Take what you need de la</p>

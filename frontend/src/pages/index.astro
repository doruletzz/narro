---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Narro — Branding și Comunicare Vizuală" description="Dăm viață brandului tău. Branding, design vizual și comunicare pentru business-uri și organizații sociale.">

  <style is:global>
    /* Hand-drawn doodle styles matching Figma */
    .doodle-scribble {
      opacity: 0.7;
    }
    .doodle-scribble path,
    .doodle-scribble ellipse,
    .doodle-scribble circle {
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  </style>

  <!-- ===== Hero Section ===== -->
  <section class="relative overflow-hidden py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8" style="background-color: #f5f0eb;">
    <!-- Doodle decorations matching Figma style — colorful scattered scribbles -->
    <!-- Top-left: pink scribble star -->
    <div class="absolute top-6 left-8 sm:left-16 md:left-20 w-14 sm:w-16 pointer-events-none doodle-scribble" style="transform: rotate(-12deg);">
      <svg viewBox="0 0 120 120" fill="none">
        <path d="M60 10 L65 45 L100 45 L72 62 L85 95 L60 75 L35 95 L48 62 L20 45 L55 45Z" stroke="#ff99d8" stroke-width="3.5" fill="none"/>
      </svg>
    </div>
    <!-- Top-center-left: green scribble spiral -->
    <div class="absolute top-20 left-1/4 w-12 sm:w-14 pointer-events-none doodle-scribble" style="transform: rotate(15deg);">
      <svg viewBox="0 0 100 100" fill="none">
        <path d="M50 50 Q55 40 50 30 Q40 25 30 35 Q25 50 35 60 Q50 65 65 55 Q75 40 70 25 Q60 5 40 10 Q15 20 15 50 Q15 80 40 90 Q70 95 90 70" stroke="#4ade80" stroke-width="3" fill="none" opacity="0.6"/>
      </svg>
    </div>
    <!-- Top-right: orange scribble -->
    <div class="absolute top-10 right-8 sm:right-16 md:right-24 w-20 sm:w-24 pointer-events-none doodle-scribble" style="transform: rotate(-25deg);">
      <svg viewBox="0 0 150 80" fill="none">
        <path d="M10 40 Q30 10 60 40 Q90 70 120 40 Q140 20 145 40" stroke="#f97316" stroke-width="3.5" fill="none"/>
        <path d="M15 50 Q35 25 55 50 Q75 75 95 50 Q115 30 140 50" stroke="#f97316" stroke-width="2.5" fill="none" opacity="0.5"/>
      </svg>
    </div>
    <!-- Below title left: blue scribble swirl -->
    <div class="absolute top-48 sm:top-56 left-4 sm:left-10 w-16 sm:w-20 pointer-events-none doodle-scribble">
      <svg viewBox="0 0 100 100" fill="none">
        <path d="M20 80 Q10 50 30 30 Q50 10 70 25 Q90 40 85 65 Q80 90 55 90 Q30 90 20 80Z" stroke="#2200d8" stroke-width="3" fill="none" opacity="0.4"/>
        <path d="M30 75 Q25 55 40 40 Q55 25 70 35 Q85 45 80 60" stroke="#2200d8" stroke-width="2" fill="none" opacity="0.3"/>
      </svg>
    </div>
    <!-- Below title right: yellow scribble -->
    <div class="absolute top-44 sm:top-52 right-4 sm:right-10 w-14 sm:w-16 pointer-events-none doodle-scribble" style="transform: rotate(20deg);">
      <svg viewBox="0 0 100 80" fill="none">
        <path d="M10 40 Q25 15 50 30 Q75 45 90 20" stroke="#facc15" stroke-width="3" fill="none"/>
        <path d="M15 55 Q30 35 55 48 Q80 60 95 35" stroke="#facc15" stroke-width="2.5" fill="none" opacity="0.5"/>
      </svg>
    </div>
    <!-- Bottom-left: pink scribble lines -->
    <div class="absolute bottom-12 sm:bottom-20 left-4 sm:left-12 w-24 sm:w-32 pointer-events-none doodle-scribble" style="transform: rotate(8deg);">
      <svg viewBox="0 0 150 60" fill="none">
        <path d="M5 30 Q25 10 50 25 Q75 40 100 20 Q125 5 145 25" stroke="#ff99d8" stroke-width="3" fill="none"/>
        <path d="M10 40 Q30 20 55 35 Q80 50 105 30 Q130 15 148 35" stroke="#ff99d8" stroke-width="2" fill="none" opacity="0.5"/>
        <path d="M0 20 Q20 0 45 15 Q70 30 95 10 Q120 -5 150 15" stroke="#ff99d8" stroke-width="2" fill="none" opacity="0.3"/>
      </svg>
    </div>
    <!-- Bottom-right: green scribble -->
    <div class="absolute bottom-8 sm:bottom-16 right-4 sm:right-12 w-20 sm:w-24 pointer-events-none doodle-scribble" style="transform: rotate(-15deg);">
      <svg viewBox="0 0 120 70" fill="none">
        <path d="M10 35 Q30 10 60 25 Q90 40 110 15" stroke="#4ade80" stroke-width="3" fill="none"/>
        <path d="M5 50 Q25 30 55 45 Q85 60 105 35" stroke="#4ade80" stroke-width="2.5" fill="none" opacity="0.5"/>
      </svg>
    </div>
    <!-- Scattered small dots and shapes -->

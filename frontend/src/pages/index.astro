      <div class="w-full h-full rounded-full" style="background: #ff99d8; opacity: 0.4;"></div>
    </div>
    <div class="absolute top-56 left-1/3 w-3 h-3 pointer-events-none">
      <div class="w-full h-full rounded-full" style="background: #facc15; opacity: 0.5;"></div>
    </div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="text-center">
        <!-- CTA badge — pink pill -->
        <a href="/contact" class="inline-flex items-center gap-2 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white rounded-full mb-8" style="background-color: #ff99d8;">
          ZI-NE CARE-I TREABA
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-extrabold leading-[1.1] tracking-tight" style="color: #2200d8;">
          Titlu lung cu bucata de text de subliniat.
        </h1>
      </div>
    </div>
  </section>

  <!-- ===== Manifesto Section ===== -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24" style="background-color: #f5f0eb;">
    <!-- Pink scribble rays above/left of image -->
    <div class="absolute top-8 sm:top-12 left-8 sm:left-16 md:left-20 w-24 sm:w-32 pointer-events-none doodle-scribble" style="transform: rotate(-15deg);">
      <svg viewBox="0 0 150 80" fill="none">
        <path d="M10 70 Q25 50 30 30" stroke="#ff99d8" stroke-width="3.5" fill="none"/>
        <path d="M25 75 Q40 55 48 35" stroke="#ff99d8" stroke-width="3" fill="none"/>
        <path d="M40 78 Q55 58 62 38" stroke="#ff99d8" stroke-width="2.5" fill="none"/>
        <path d="M55 75 Q68 55 75 35" stroke="#ff99d8" stroke-width="3" fill="none"/>
        <path d="M70 70 Q82 50 88 30" stroke="#ff99d8" stroke-width="2.5" fill="none"/>
      </svg>
    </div>
    <!-- Pink crown doodle above image -->
    <div class="absolute top-4 sm:top-8 left-1/3 sm:left-1/3 w-12 sm:w-16 pointer-events-none doodle-scribble">
      <svg viewBox="0 0 100 60" fill="none">
        <path d="M15 55 L20 25 L35 40 L50 15 L65 40 L80 25 L85 55" stroke="#facc15" stroke-width="4" fill="none"/>
      </svg>
    </div>
    <!-- Orange scribble below image -->
    <div class="absolute bottom-8 sm:bottom-12 left-8 sm:left-16 w-20 sm:w-28 pointer-events-none doodle-scribble" style="transform: rotate(10deg);">
      <svg viewBox="0 0 120 50" fill="none">
        <path d="M5 25 Q20 5 40 20 Q60 35 80 15 Q100 -5 115 20" stroke="#f97316" stroke-width="3" fill="none"/>
        <path d="M10 35 Q25 15 45 30 Q65 45 85 25 Q105 10 120 30" stroke="#f97316" stroke-width="2" fill="none" opacity="0.5"/>
      </svg>
    </div>
    <!-- Large pink spiral on the right side — matching Figma -->
    <div class="absolute bottom-4 sm:bottom-8 right-4 sm:right-8 md:right-16 w-28 sm:w-40 md:w-48 pointer-events-none doodle-scribble">
      <svg viewBox="0 0 150 150" fill="none">
        <path d="M75 75 Q78 65 85 60 Q95 55 100 65 Q105 80 95 90 Q80 100 65 95 Q45 88 40 70 Q35 50 50 35 Q65 20 85 25 Q110 30 120 55 Q130 80 125 105 Q118 130 95 138 Q70 145 45 135 Q20 125 12 100 Q5 75 15 50 Q25 25 50 15 Q75 5 100 15 Q125 25 138 50 Q150 75 148 105" stroke="#ff99d8" stroke-width="4" fill="none"/>
      </svg>
    </div>

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Image -->
        <div class="relative">
          <div class="aspect-[4/3] rounded-lg overflow-hidden">
            <!-- TODO: Replace with Figma asset — 3 women on rocket image -->
            <img
              src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&q=80"
              alt="Echipa Narro — Branding manifest"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <!-- Text -->
        <div class="space-y-5 pt-2 lg:pt-4">
          <h2 class="text-xl sm:text-2xl font-heading font-bold uppercase tracking-[0.2em]" style="color: #ff99d8;">MANIFESTO</h2>
          <div class="space-y-4 text-neutral-800 leading-relaxed text-sm sm:text-base">
            <p>
              <strong>Branding</strong> wears many faces. We peel them back like bad wallpaper. We find the heartbeat and let it set the pace.
            </p>
            <p>
              <strong>The result:</strong> a logo that bites, a palette that sings, a font that winks back. All of them alive. All of them trouble.
            </p>
            <p>
              You will recognize it by its constant motion. It fidgets. It interrupts. It leaves the room then comes back with better stories.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Directia Section ===== -->

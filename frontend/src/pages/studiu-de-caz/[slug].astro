---
import PageLayout from '../../layouts/PageLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'startupx' } },
    { params: { slug: 'brandy' } },
    { params: { slug: 'ong-z' } },
  ];
}

const { slug } = Astro.params;

// TODO: Fetch case study data from Keystatic collection
const caseStudy = {
  heroImage: 'https://images.unsplash.com/photo-1558618666-fcd25c85f32e?w=1400&q=80',
  title: 'Studiu de Caz: ' + slug,
  client: 'Client Name',
  industry: 'Industry',
};
---

<PageLayout title={caseStudy.title} description={caseStudy.title + ' — Narro Branding'}>

  <!-- Hero Image — Full width -->
  <section class="w-full">
    <div class="aspect-[16/8] bg-cream overflow-hidden">
      <img
        src={caseStudy.heroImage}
        alt={caseStudy.title}
        class="w-full h-full object-cover"
      />
    </div>
  </section>

  <!-- Content Sections — Single column, cream bg -->
  <section class="px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-3xl mx-auto space-y-14">
      <!-- Context -->
      <div>
        <h2 class="text-lg font-heading font-bold text-[#ff99d8] uppercase tracking-widest mb-4">CONTEXT</h2>
        <p class="text-neutral-700 leading-relaxed text-sm">
          Lorem ipsum dolor sit amet consectetur. Suspendisse sit vitae mi sed enim est tempor integer. Nunc sem facilisis consequat aliquam iaculis senectus. Dolor ac amet ornare pellentesque est donec. Quis enim fermentum scelerisque pellentesque ipsum nisl faucibus praesent ullamcorper. Metus pellentesque mi tellus potenti in ante. Faucibus quis non adipiscing nisi. Nisl gravida dui massa phasellus sed et.
        </p>
      </div>

      <!-- Problema -->

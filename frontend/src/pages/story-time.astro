---
import CtaBanner from '@/components/sections/CtaBanner.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { parseMarkdown } from '@/lib/markdown-utils';

// NOTE: Keystatic stores uploads in public/ (root-relative paths), and
// Astro's <Image> component can't process public/ assets — only imported
// images or remote URLs. So these CMS images stay as plain <img> tags.

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.storyTime.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Story Time content not found — fill it in at /keystatic');
}

const { title, description, stories } = page;
const { ctaBanner } = home || {};
---

<PageLayout title={title} description={description}>
  <Header />

  <!-- Story Cards Section -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-12">
    <!-- Sketch doodle decorations — scattered, fade-in -->
    <div class="absolute top-36 left-0 sm:left-6 w-72 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" class="scale-125 -hue-rotate-60 brightness-110 saturate-50" />
    </div>
    <div class="absolute top-20 right-0 sm:right-10 w-80 pointer-events-none doodle-scribble fade-in fade-delay-4 sm:block hidden" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-2.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[190deg] contrast-150" />
    </div>
    <div class="absolute top-1/4 left-2 sm:left-32 mt-20 w-48 pointer-events-none doodle-scribble fade-in fade-delay-6" style="transform: rotate(18deg);">
      <img src="/sketches/sketch-8.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-1/4 right-4 sm:-right-24 w-80 pointer-events-none doodle-scribble fade-in fade-delay-7 sm:block hidden" style="transform: rotate(-8deg);">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[220deg] contrast-150 brightness-110" />
    </div>
    <div class="absolute bottom-1/4 left-4 sm:left-10 w-64 pointer-events-none doodle-scribble fade-in fade-delay-5" style="transform: rotate(14deg);">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 right-2 sm:right-14 w-96 pointer-events-none doodle-scribble fade-in fade-delay-7 sm:block hidden">
      <img src="/sketches/sketch-7.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[-260deg] contrast-100 "  style="transform: rotate(16deg);" />
    </div>
    <div class="absolute bottom-0 left-2 sm:-left-20 w-72 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(6deg);">
      <img src="/sketches/sketch-4.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-1/2 right-0 sm:right-8 w-64 pointer-events-none doodle-scribble fade-in fade-delay-2 sm:block hidden" style="transform: rotate(-20deg);">
      <img src="/sketches/sketch-6.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-7xl mx-auto space-y-48">
      {stories.map((story, index) => {
        const flipped = index % 2 === 1;
        return (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div class:list={['relative', flipped && 'lg:order-2 order-1']}>
              <div class="aspect-square bg-cream rounded-lg overflow-hidden fade-in fade-delay-4">
                <img
                  src={story.image}
                  alt={story.imageAlt}
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
            <div class:list={['space-y-6', flipped && 'lg:order-1 order-2']}>
              <h2 class="active fade-in text-4xl font-heading font-bold uppercase tracking-[0.2em] mb-4" style="color: #ff99d8;">{
                story.title
                }</h2>
                {story.paragraphs.map((paragraph, index) => (
                  <p set:html={parseMarkdown(paragraph)} class={`leading-relaxed text-xl max-w-lg fade-in fade-delay-${index * 2 + 2}`} />
                ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- CTA Banner — Pink pill with arrow -->
  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>

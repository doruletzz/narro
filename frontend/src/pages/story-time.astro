---
import CtaBanner from '@/components/sections/CtaBanner.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// NOTE: Keystatic stores uploads in public/ (root-relative paths), and
// Astro's <Image> component can't process public/ assets — only imported
// images or remote URLs. So these CMS images stay as plain <img> tags.

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.storyTime.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Story Time content not found — fill it in at /keystatic');
}

const { title, description, stories } = page;
const { ctaBanner } = home || {};

// Sketch doodle decorations, cycled per story (odd stories get the flipped layout).
const DOODLES = [
  { src: '/sketches/sketch-7.svg', class: '-top-2 -right-2 w-60 h-60' },
  { src: '/sketches/sketch-6.svg', class: '-bottom-3 -left-3 w-64 h-64' },
  { src: '/sketches/sketch-1.svg', class: '-top-2 -left-2 w-60 h-60' },
];
---

<PageLayout title={title} description={description}>
  <Header />

  <!-- Story Cards Section -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-12">
    <!-- Sketch doodle decorations -->
    <div class="absolute bottom-6 left-4 sm:left-8 w-72 pointer-events-none">
      <img src="/sketches/sketch-4.svg" />
    </div>
    <div class="absolute top-8 right-8 sm:right-12 w-72 pointer-events-none">
      <img src="/sketches/sketch-5.svg" />
    </div>

    <div class="max-w-7xl mx-auto space-y-48">
      {stories.map((story, index) => {
        const doodle = DOODLES[index % DOODLES.length];
        const flipped = index % 2 === 1;
        return (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div class:list={['relative', flipped && 'lg:order-2 order-1']}>
              <div class="aspect-square bg-cream rounded-lg overflow-hidden fade-in fade-delay-4">
                <img
                  src={story.image}
                  alt={story.imageAlt}
                  class="w-full h-full object-cover"
                />
              </div>
              <!-- Sketch doodle -->
              <div class:list={['absolute pointer-events-none', doodle.class]}>
                <img src={doodle.src} />
              </div>
            </div>
            <div class:list={['space-y-6', flipped && 'lg:order-1 order-2']}>
              <h2 class="active fade-in text-4xl font-heading font-bold uppercase tracking-[0.2em] mb-4" style="color: #ff99d8;">{
                story.title
                }</h2>
                {story.paragraphs.map((paragraph, index) => (
                  <p class={`leading-relaxed text-xl max-w-lg fade-in fade-delay-${index * 2 + 2}`}>
                    {paragraph}
                  </p>
                ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- CTA Banner — Pink pill with arrow -->
  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Program Social — Narro" description="Servicii de branding și comunicare vizuală accesibile pentru ONG-uri și organizații sociale.">

  <!-- Pro Bono Section — Image left with doodle, text right -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Image with orange doodle decorations -->
        <div class="relative">
          <div class="aspect-[4/3] bg-cream rounded-lg overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=700&q=80"
              alt="Pro Bono — Echipa Narro la voluntariat"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Orange scribble doodle behind image -->
          <div class="absolute -top-8 -right-8 w-40 h-40 pointer-events-none">
            <svg viewBox="0 0 200 200" fill="none">
              <path d="M100 20 Q150 50 160 100 Q170 150 100 180 Q30 150 40 100 Q50 50 100 20Z" stroke="#f97316" stroke-width="5" stroke-linecap="round" opacity="0.3"/>
              <path d="M80 40 Q130 60 140 100 Q150 140 80 160 Q10 140 20 100 Q30 60 80 40Z" stroke="#f97316" stroke-width="3" stroke-linecap="round" opacity="0.2"/>
              <path d="M60 60 Q100 30 160 60" stroke="#f97316" stroke-width="3" stroke-linecap="round" opacity="0.15"/>
              <path d="M50 80 Q80 60 140 70" stroke="#f97316" stroke-width="2" stroke-linecap="round" opacity="0.15"/>
              <path d="M40 100 Q60 90 100 95" stroke="#f97316" stroke-width="2" stroke-linecap="round" opacity="0.15"/>
            </svg>
          </div>
        </div>
        <!-- Text -->
        <div class="space-y-6 pt-4">
          <h2 class="text-3xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest">PRO BONO</h2>
          <p class="text-neutral-700 leading-relaxed text-sm">
            Lorem ipsum dolor sit amet consectetur. Ut adipiscing risus mi quis magna etiam sem nunc. Magnis volutpat amet diam natoque nunc mattis amet bibendum risus.
          </p>
          <p class="text-neutral-700 leading-relaxed text-sm">
            Lorem ipsum dolor sit amet consectetur. Ut adipiscing risus mi quis magna etiam sem nunc. Magnis volutpat amet diam natoque nunc mattis amet bibendum risus.
          </p>
          <p class="text-neutral-700 leading-relaxed text-sm">
            Lorem ipsum dolor sit amet consectetur. Ut adipiscing risus mi quis magna etiam sem nunc. Magnis volutpat amet diam natoque nunc mattis amet bibendum risus.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Aplica Acum Section — Form left, image right with doodles -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20">
    <!-- Purple doodle -->
    <div class="absolute top-20 right-8 w-24 h-24 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none">
        <path d="M50 10 Q70 30 80 50 Q90 70 50 90 Q10 70 20 50 Q30 30 50 10Z" stroke="#a855f7" stroke-width="4" stroke-linecap="round" opacity="0.2"/>
      </svg>
    </div>
    <!-- Yellow doodle -->
    <div class="absolute bottom-20 right-12 w-16 h-16 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none">
        <path d="M20 80 Q40 30 60 50 Q80 20 90 40" stroke="#facc15" stroke-width="4" stroke-linecap="round" opacity="0.3"/>
      </svg>
    </div>
    
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest mb-12 text-center">APLICA ACUM</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Form — White box -->
        <div class="bg-white rounded-lg p-8 md:p-10">
          <p class="text-neutral-700 leading-relaxed text-sm mb-8">
            Lorem ipsum dolor sit amet consectetur. Ut adipiscing risus mi quis magna etiam sem nunc. Magnis volutpat amet diam natoque nunc mattis amet bibendum risus.
          </p>
          <form class="space-y-4" aria-label="Formular de aplicare program pro bono">
            <div>
              <label for="form-name" class="sr-only">Nume*</label>
              <input
                id="form-name"
                type="text"
                placeholder="Nume*"
                required
                class="w-full px-4 py-3 border border-neutral-400 rounded bg-white text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary transition-colors text-sm"
              />
            </div>
            <div>
              <label for="form-email" class="sr-only">E-mail*</label>
              <input
                id="form-email"
                type="email"
                placeholder="E-mail*"
                required
                class="w-full px-4 py-3 border border-neutral-400 rounded bg-white text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary transition-colors text-sm"
              />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="form-business" class="sr-only">Business</label>
                <input
                  id="form-business"
                  type="text"
                  placeholder="Business"
                  class="w-full px-4 py-3 border border-neutral-400 rounded bg-white text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary transition-colors text-sm"
                />
              </div>
              <div>
                <label for="form-budget" class="sr-only">Buget</label>
                <select
                  id="form-budget"
                  class="w-full px-4 py-3 border border-neutral-400 rounded bg-white text-neutral-900 focus:outline-none focus:border-primary transition-colors appearance-none text-sm"
                >
                  <option value="" disabled selected>Buget</option>
                  <option value="<5000">Sub 5.000 EUR</option>
                  <option value="5000-10000">5.000 - 10.000 EUR</option>
                  <option value="10000-20000">10.000 - 20.000 EUR</option>
                  <option value=">20000">Peste 20.000 EUR</option>
                </select>
              </div>
            </div>
            <div>
              <label for="form-message" class="sr-only">Care-i treaba?</label>
              <textarea
                id="form-message"
                placeholder="Care-i treaba?"
                rows={4}
                class="w-full px-4 py-3 border border-neutral-400 rounded bg-white text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-primary transition-colors resize-none text-sm"
              ></textarea>
            </div>
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 border border-neutral-400 text-neutral-900 font-medium hover:bg-neutral-900 hover:text-white transition-colors rounded text-sm"
            >
              Trimite
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </button>
          </form>
        </div>
        <!-- Image with doodle decorations -->
        <div class="relative">
          <div class="aspect-[4/3] bg-cream rounded-lg overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1558618666-fcd25c85f32e?w=700&q=80"
              alt="Aplica acum — Contact Narro"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Purple swirl doodle -->
          <div class="absolute -top-4 -left-4 w-32 h-32 pointer-events-none">
            <svg viewBox="0 0 150 150" fill="none">
              <circle cx="75" cy="75" r="50" stroke="#a855f7" stroke-width="4" opacity="0.2"/>
              <circle cx="75" cy="75" r="35" stroke="#a855f7" stroke-width="3" opacity="0.15"/>
              <circle cx="75" cy="75" r="20" stroke="#a855f7" stroke-width="2" opacity="0.1"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
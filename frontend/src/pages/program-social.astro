---
import Header from '@/components/layouts/Header.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { parseMarkdown } from '@/lib/markdown-utils';

// NOTE: Keystatic stores uploads in public/ (root-relative paths), and
// Astro's <Image> component can't process public/ assets — only imported
// images or remote URLs. So these CMS images stay as plain <img> tags.

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.programSocial.read();

if (!page) {
  throw new Error('Program Social content not found — fill it in at /keystatic');
}

const { title, description, proBono, aplicAcum } = page;
const formFields = aplicAcum.form?.fields ?? [];
const submitLabel = aplicAcum.form?.submitLabel ?? 'Trimite';
---

<PageLayout title={title} description={description}>
  <Header />

  <!-- Pro Bono Section — Image left with sketch, text right -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-24">
    <!-- Sketch doodle decorations — scattered, fade-in -->
   <div class="absolute top-12 left-0 sm:left-8 w-72 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(-12deg);">
      <img src="/sketches/sketch-4.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute -top-12 right-0 sm:right-12 w-96 pointer-events-none doodle-scribble fade-in fade-delay-4 sm:block hidden" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" class="scale-150 hue-rotate-[40deg] contrast-150" />
    </div>
    <div class="absolute bottom-0 left-4 sm:left-2/3 w-80 pointer-events-none doodle-scribble fade-in fade-delay-7" style="transform: rotate(-8deg);">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[0deg] scale-x-[-1] opacity-50" />
    </div>
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2  gap-12 items-start">
        <!-- Image with sketch decorations -->
        <div class="relative">
          <div class="aspect-[2/2] fade-in fade-delay-4 rounded-lg overflow-hidden">
            <img
              src={proBono.image}
              alt={proBono.imageAlt}
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <!-- Text -->
        <div class="space-y-6 my-auto">
          <h2 class="text-4xl fade-in font-heading font-bold text-[#ff99d8] uppercase tracking-widest">{proBono.heading}</h2>
          {proBono.paragraphs.map((paragraph, index) => (
            <p set:html={parseMarkdown(paragraph)} class={`text-neutral-700 leading-relaxed text-lg fade-in fade-delay-${index * 2 + 2}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Aplica Acum Section — Form left, image right with sketch decorations -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20">
    <!-- Sketch doodle decorations — scattered, fade-in -->
    <div class="absolute top-4 left-0 sm:left-8 w-64 pointer-events-none doodle-scribble fade-in fade-delay-2" style="transform: rotate(10deg);">
      <img src="/sketches/sketch-6.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-16 right-4 sm:right-12 w-72 pointer-events-none doodle-scribble fade-in fade-delay-4 sm:block hidden" style="transform: rotate(-18deg);">
      <img src="/sketches/sketch-2.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[195deg] contrast-110 brightness-110" />
    </div>
    <div class="absolute bottom-24 left-2 sm:left-14 w-80 pointer-events-none doodle-scribble fade-in fade-delay-6" style="transform: rotate(14deg);">
      <img src="/sketches/sketch-8.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-6 right-4 sm:right-20 w-48 pointer-events-none doodle-scribble fade-in fade-delay-3" style="transform: rotate(-6deg);">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" class="hue-rotate-[170deg] contrast-100 scale-150 brightness-120 opacity-50" />
    </div>

    <div class="max-w-7xl mx-auto mt-8">
      <h2 class="fade-in text-4xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest mb-12 text-center">{aplicAcum.heading}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Form — White box with clean thin borders -->
        <div class="bg-white p-6 md:p-10 rounded-2xl z-10">
          <p class="fade-in text-neutral-800 leading-relaxed mb-4 md:mb-8 md:text-lg fade-in">
            {aplicAcum.intro}
          </p>
          {/* Web3Forms — action: https://web3forms.com */}
          <form action="https://web3forms.com/submit" method="POST" class="space-y-4" aria-label="Formular de aplicare program pro bono">
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
            <input type="hidden" name="redirect" value="/program-social?sent=success" />
            <input type="hidden" name="subject" value="Narro — Program Social application" />
            {/* Honeypot — hidden spam protection. Bots fill this, humans don't see it. */}
            <input type="text" name="name" style="display:none" tabindex="-1" autocomplete="off" />
            {formFields.map((field, index) => (
              <div class={`fade-in fade-delay-${index + 2}`}>
                {field.type === 'select' ? (
                  <>
                    <label for={`program-social-${field.id}`} class="sr-only">{field.label}</label>
                    <select
                      id={`program-social-${field.id}`}
                      name={field.id}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white valid:text-neutral-900 text-neutral-900/75 focus:outline-none focus:border-primary transition-colors appearance-none text-md"
                    >
                      <option value="" disabled selected>{field.label}</option>
                      {(field.options ?? []).map((option) => (
                        <option value={option.value}>{option.label}</option>
                      ))}
                    </select>
                  </>
                ) : field.type === 'textarea' ? (
                  <>
                    <label for={`program-social-${field.id}`} class="sr-only">{field.label}</label>
                    <textarea
                      id={`program-social-${field.id}`}
                      name={field.id}
                      placeholder={field.label}
                      rows={5}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors resize-none text-md"
                    ></textarea>
                  </>
                ) : (
                  <>
                    <label for={`program-social-${field.id}`} class="sr-only">{field.label}</label>
                    <input
                      id={`program-social-${field.id}`}
                      name={field.id}
                      type={field.inputType || 'text'}
                      placeholder={field.label}
                      required={field.required || undefined}
                      class="w-full px-5 py-3 border border-neutral-900 rounded-none bg-white text-neutral-900 placeholder-neutral-900/75 focus:outline-none focus:border-primary transition-colors text-md"
                    />
                  </>
                )}
              </div>
            ))}
            <!-- Submit -->
            <button
              type="submit"
              class={`inline-flex items-center gap-2 px-6 py-3 border border-neutral-900 text-neutral-900 font-medium hover:bg-neutral-900 hover:text-white transition-colors rounded-none text-md fade-in fade-delay-${formFields.length + 2}`}
            >
              {submitLabel}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </button>
          </form>
        </div>
        <!-- Image with sketch decorations -->
        <div class="relative">
          <div class="aspect-[4/3] bg-cream rounded-lg overflow-hidden">
            <img
              src={aplicAcum.image}
              alt={aplicAcum.imageAlt}
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Sketch doodle decoration -->
          <div class="absolute -top-4 -left-4 w-72 h-72 pointer-events-none">
            <img src="/sketches/sketch-6.svg" />
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

---
import PageLayout from '@/layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Slider from '@/components/ui/Slider.astro';
import Card from '@/components/ui/Card.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.studiiDeCazPage.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Studii de Caz content not found — fill it in at /keystatic');
}

const { label, items } = page;
const { ctaBanner } = home || {};
const DEFAULT_STUDII_INDEX = -1;
---

<PageLayout title="Studii de Caz — Narro" description="Portofoliul nostru de proiecte. Vezi cum am ajutat clienții noștri.">
  <style>
    /* Card sizing for horizontal scroll/overflow */
    .studii-card {
      flex: 0 0 82vw;
      transition: transform 0.5s ease, opacity 0.5s ease;
    }

    @media (min-width: 768px) {
      .studii-card {
        flex: 0 0 24rem; /* Fixed width forces horizontal overflow on desktop */
      }
    }

    .studii-card.is-active {
      transform: scale(1.02);
    }
  </style>

  <script is:inline>
   
  </script>

  <Header />

  <section class="relative py-16 sm:py-20 lg:py-24 overflow-x-hidden" style="background-color: #f5f0eb;">
    <div class="absolute top-4 left-2 sm:left-6 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 right-4 sm:right-12 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="mx-auto relative z-10">
      <h2 class="fade-in fade-delay-4 lg:pl-72 -ml-8 text-4xl font-heading font-bold uppercase tracking-[0.2em] mb-8 sm:mb-10 text-center sm:text-left" style="color: #ff99d8;">
        {label}
      </h2>

      <Slider class=" px-72 -ml-12 " id="studii-wrapper" data-default-active={DEFAULT_STUDII_INDEX} bleed={true} snap={true}>
        {items.map((item, index) => (
          <Card
            href={`/studii-de-caz/${item.slug}`}
            image={item.image}
            imageAlt={item.imageAlt}
            imgWrapperClass="h-[22rem] w-[30rem] rounded-lg border-2 border-[#2200d8]"
            class:list={['studii-card fade-in cursor-pointer scroll-pl-32 p-4 hover:bg-white duration-50 rounded-xl transition-colors', index === DEFAULT_STUDII_INDEX && 'is-active bg-white', `fade-delay-${index * 2 + 1}`]}
          >
            <h3 class="text-2xl font-heading font-bold mb-1" style="color: #2200d8;">{item.title}</h3>
            <p class="text-md leading-relaxed max-w-xs">{item.tag}</p>
          </Card>
        ))}
      </Slider>
    </div>
  </section>

  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>
---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Studii de Caz — Narro" description="Portofoliul nostru de proiecte. Vezi cum am ajutat clienții noștri.">

  <!-- Studii de Caz — Horizontal scrollable cards -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20 bg-cream">
    <!-- Doodle star -->
    <div class="absolute top-10 right-12 w-12 h-12 pointer-events-none">
      <svg viewBox="0 0 100 100" fill="none">
        <path d="M50 5 L60 35 L95 35 L67 55 L77 85 L50 68 L23 85 L33 55 L5 35 L40 35Z" stroke="#facc15" stroke-width="3" opacity="0.5"/>
      </svg>
    </div>
    
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest mb-10">STUDII DE CAZ</h2>
      <div class="overflow-x-auto pb-4 -mx-4 sm:mx-0">
        <div class="flex gap-4 min-w-0 px-4 sm:px-0">
          <!-- Card 1 — Social Media (wide horizontal card) -->
          <div class="flex-shrink-0 w-72 sm:w-80 md:w-96">
            <div class="rounded-lg overflow-hidden border border-primary/30">
              <div class="aspect-[16/10] bg-white relative">
                <img
                  src="https://images.unsplash.com/photo-1611162617213-7d7a39e9b1d7?w=800&q=80"
                  alt="Social Media studiu de caz"
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 rounded text-[10px] font-medium text-[#ff99d8]">
                  vs firme noi, design în stradă vs reclame luminoase
                </div>
              </div>
              <div class="p-4 bg-white border-t border-primary/10">
                <h3 class="text-lg font-heading font-bold text-primary">Social Media</h3>
              </div>
            </div>
          </div>
          <!-- Card 2 — Branding -->
          <div class="flex-shrink-0 w-72 sm:w-80 md:w-96">
            <div class="rounded-lg overflow-hidden border border-primary/30">
              <div class="aspect-[16/10] bg-white relative">
                <img
                  src="https://images.unsplash.com/photo-1558618666-fcd25c85f32e?w=800&q=80"
                  alt="Branding studiu de caz"
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 rounded text-[10px] font-medium text-[#ff99d8]">
                  viața-i grea (fă-o mai grea, deschide-ți agenția)
                </div>
              </div>
              <div class="p-4 bg-white border-t border-primary/10">
                <h3 class="text-lg font-heading font-bold text-primary">Branding</h3>
              </div>
            </div>
          </div>
          <!-- Card 3 — Continut Foto-Video -->
          <div class="flex-shrink-0 w-72 sm:w-80 md:w-96">
            <div class="rounded-lg overflow-hidden border border-primary/30">
              <div class="aspect-[16/10] bg-white relative">
                <img
                  src="https://images.unsplash.com/photo-1561071397-586787dd5340?w=800&q=80"
                  alt="Continut Foto-Video studiu de caz"
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 rounded text-[10px] font-medium text-[#ff99d8]">
                  Take what you need de la
                </div>
              </div>
              <div class="p-4 bg-white border-t border-primary/10">
                <h3 class="text-lg font-heading font-bold text-primary">Continut Foto-Video</h3>
              </div>
            </div>
          </div>
          <!-- Card 4 — Continut Foto-Video (repeat for scroll) -->
          <div class="flex-shrink-0 w-72 sm:w-80 md:w-96">
            <div class="rounded-lg overflow-hidden border border-primary/30">
              <div class="aspect-[16/10] bg-white relative">
                <img
                  src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=800&q=80"
                  alt="Continut Foto-Video studiu de caz"
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 rounded text-[10px] font-medium text-[#ff99d8]">
                  vs reviste vs carti
                </div>
              </div>
              <div class="p-4 bg-white border-t border-primary/10">
                <h3 class="text-lg font-heading font-bold text-primary">Continut Foto-Video</h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner — Pink pill with arrow -->
  <section class="relative overflow-hidden py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="relative">
        <img
          src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=1000&q=80"
          alt="CTA — Zi-ne care-i treaba"
          class="w-full aspect-[16/9] object-cover rounded-2xl"
        />
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2">
          <a href="/contact" class="inline-flex items-center gap-3 bg-[#ff99d8] rounded-full px-10 md:px-14 py-4 flex-shrink-0">
            <span class="text-2xl md:text-3xl font-heading font-bold text-primary tracking-wider">ZI-NE CARE-I TREABA?</span>
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
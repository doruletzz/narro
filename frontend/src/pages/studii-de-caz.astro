---
import PageLayout from '@/layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Slider from '@/components/ui/Slider.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// NOTE: Keystatic stores uploads in public/ (root-relative paths), and
// Astro's <Image> component can't process public/ assets — only imported
// images or remote URLs. So these CMS images stay as plain <img> tags.

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.studiiDeCazPage.read();

if (!page) {
  throw new Error('Studii de Caz content not found — fill it in at /keystatic');
}

const { label, items } = page;
---

<PageLayout title="Studii de Caz — Narro" description="Portofoliul nostru de proiecte. Vezi cum am ajutat clienții noștri.">
  <Header />

  <!-- Studii de Caz — Horizontal scrollable cards, allowed to bleed past the content edge -->
  <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 py-20 bg-cream">
    <div class="absolute top-2 left-4 sm:left-10 w-72 pointer-events-none">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute top-6 right-6 sm:right-16 w-72 pointer-events-none">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 left-1/3 sm:left-[35%] w-72 pointer-events-none">
      <img src="/sketches/sketch-5.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-4 right-12 sm:right-24 w-72 pointer-events-none">
      <img src="/sketches/sketch-7.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-heading font-bold text-[#ff99d8] uppercase tracking-widest mb-10">{label}</h2>

      <Slider bleed>
        {items.map((item, index) => (
          <div class="w-fit flex-shrink-0">
            <div class="w-72 sm:w-80 md:w-96 rounded-lg overflow-hidden border border-primary/30">
              <div class="aspect-[16/10] bg-white relative">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 rounded text-[10px] font-medium text-[#ff99d8]">
                  {item.tag}
                </div>
              </div>
              <div class="p-4 bg-white border-t border-primary/10">
                <h3 class="text-lg font-heading font-bold text-primary">{item.title}</h3>
              </div>
            </div>
          </div>
        ))}
      </Slider>
    </div>
  </section>

  <CtaBanner />
</PageLayout>
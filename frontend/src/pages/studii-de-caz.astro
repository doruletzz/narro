---
import PageLayout from '@/layouts/PageLayout.astro';
import Header from '@/components/layouts/Header.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Slider from '@/components/ui/Slider.astro';
import Card from '@/components/ui/Card.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const page = await reader.singletons.studiiDeCazPage.read();
const home = await reader.singletons.homepage.read();

if (!page) {
  throw new Error('Studii de Caz content not found — fill it in at /keystatic');
}

const { label, items } = page;
const { ctaBanner } = home || {};
const DEFAULT_STUDII_INDEX = 0;
---

<PageLayout title="Studii de Caz — Narro" description="Portofoliul nostru de proiecte. Vezi cum am ajutat clienții noștri.">
  <style>
    /* Card sizing for horizontal scroll/overflow */
    .studii-card {
      flex: 0 0 82vw;
      transition: transform 0.5s ease, opacity 0.5s ease;
      opacity: 0.7;
    }

    @media (min-width: 768px) {
      .studii-card {
        flex: 0 0 24rem; /* Fixed width forces horizontal overflow on desktop */
      }
    }

    .studii-card.is-active {
      opacity: 1;
      transform: scale(1.02);
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.doodle-scribble').forEach((el) => observer.observe(el));

      const wrapper = document.getElementById('studii-wrapper');
      if (wrapper) {
        const cards = wrapper.querySelectorAll('.studii-card');

        const setActiveCard = (index) => {
          cards.forEach((card, i) => card.classList.toggle('is-active', i === index));
        };

        cards.forEach((card, index) => {
          card.addEventListener('mouseenter', () => {
            if (window.innerWidth >= 768) setActiveCard(index);
          });
        });

        const mobileObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActiveCard(Array.from(cards).indexOf(entry.target));
          });
        }, { root: wrapper, threshold: 0.65 });

        cards.forEach((card) => mobileObserver.observe(card));
      }
    });
  </script>

  <Header />

  <section class="relative py-16 sm:py-20 lg:py-24 overflow-x-hidden" style="background-color: #f5f0eb;">
    <div class="absolute top-4 left-2 sm:left-6 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-1.svg" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="absolute bottom-8 right-4 sm:right-12 w-72 pointer-events-none doodle-scribble z-0">
      <img src="/sketches/sketch-3.svg" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="mx-auto relative z-10">
      <h2 class=" pl-72 -ml-8 text-xl sm:text-4xl font-heading font-bold uppercase tracking-[0.2em] mb-8 sm:mb-10 text-center sm:text-left" style="color: #ff99d8;">
        {label}
      </h2>

      <Slider class=" px-72 -ml-8" id="studii-wrapper" data-default-active={DEFAULT_STUDII_INDEX} bleed={true} snap={true}>
        {items.map((item, index) => (
          <Card
            image={item.image}
            imageAlt={item.imageAlt}
            imgWrapperClass="h-[20rem] rounded-lg border-2 border-[#2200d8]"
            class:list={['studii-card cursor-pointer p-2 hover:bg-white duration-50 rounded-xl transition-colors', index === DEFAULT_STUDII_INDEX && 'is-active bg-white']}
          >
            <h3 class="text-lg font-heading font-bold mb-1" style="color: #2200d8;">{item.title}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed max-w-xs">{item.description}</p>
          </Card>
        ))}
      </Slider>
    </div>
  </section>

  {ctaBanner && <CtaBanner ctaBanner={ctaBanner} />}
</PageLayout>